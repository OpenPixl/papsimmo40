<div id="allpropertiessales" class="row mb-4">

    <div class="row justify-content-center g-2">
        {% for property in properties %}
            <div class="col-xs-12 col-sm-6 col-md-6 col-xl-4 col-xxl-4 p-3">
                {{ include('webapp/page/property/include/_cardProperty.html.twig') }}
            </div>
        {% else %}
            <div class="col-xs-12 col-sm-6 col-md-4 col-xl-2 col-xxl-2">
                <p>Pas de biens publiés</p>
            </div>
        {% endfor %}
        <div class="navigation d-flex justify-content-end">
            {{ knp_pagination_render(properties, 'include/admin/pagination.html.twig') }}
        </div>
    </div>
</div>