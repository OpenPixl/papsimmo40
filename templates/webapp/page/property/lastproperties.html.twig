<div class="row mb-4">
    {% if properties|length <= 3 %}
        <div class="row justify-content-center g-2">
            {% for property in properties %}
                <div class="col-xs-12 col-sm-6 col-md-6 col-xl-4 col-xxl-4">
                    {{ include('webapp/page/property/include/_cardProperty.html.twig') }}
                </div>
            {% else %}
                <div class="col-xs-12 col-sm-6 col-md-6 col-xl-4 col-xxl-4">
                    <p>Pas de biens publiés</p>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="row justify-content-center g-2">
            <div class="flickity-button-white" data-flickity='{"resize":false, "pageDots": false,"cellAlign": "left", "wrapAround": true, "imagesLoaded": true, "freeScroll": true }'>
                {% for property in properties %}
                    <div class="col-xs-12 col-sm-6 col-md-6 col-xl-4 col-xxl-4 p-4 g-3">
                        {{ include('webapp/page/property/include/_cardProperty.html.twig') }}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

</div>
