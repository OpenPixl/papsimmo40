{% extends 'base.html.twig' %}

{% block title %}Agency{% endblock %}

{% block body %}
    <h1>Agency</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ agency.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ agency.name }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ agency.slug }}</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>{{ agency.address }}</td>
            </tr>
            <tr>
                <th>Complement</th>
                <td>{{ agency.complement }}</td>
            </tr>
            <tr>
                <th>Zipcode</th>
                <td>{{ agency.zipcode }}</td>
            </tr>
            <tr>
                <th>City</th>
                <td>{{ agency.city }}</td>
            </tr>
            <tr>
                <th>ContactPhone</th>
                <td>{{ agency.contactPhone }}</td>
            </tr>
            <tr>
                <th>ContactEmail</th>
                <td>{{ agency.contactEmail }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_gestapp_agency_index') }}">back to list</a>

    <a href="{{ path('app_gestapp_agency_edit', {'id': agency.id}) }}">edit</a>

    {{ include('gestapp/agency/_delete_form.html.twig') }}
{% endblock %}
