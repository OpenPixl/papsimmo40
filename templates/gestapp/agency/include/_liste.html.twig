{% for agency in agencies %}
    <div class="row g-1 mb-1">
        <div class="col-1">{{ agency.name }}</div>
        <div class="col-3">{{ agency.address }}</div>
        <div class="col-2">{{ agency.complement }}</div>
        <div class="col-1">{{ agency.zipcode }}</div>
        <div class="col-1">{{ agency.city }}</div>
        <div class="col-1">{{ agency.contactPhone }}</div>
        <div class="col-2">{{ agency.contactEmail }}</div>
        <div class="col-1">
            <a href="{{ path('app_gestapp_agency_edit', {'id': agency.id}) }}" class="btn btn-sm btn-outline-dark" data-bs-dismiss="modal"><i class="fa-duotone fa-solid fa-eye"></i></a>
            <a href="{{ path('op_gestapp_agency_del', {'id': agency.id}) }}" class="btn btn-sm btn-warning btnModalSuppr" data-bs-dismiss="modal" data-bs-whatever="DEL-Suppression de l'agence-"><i class="fa-light fa-trash-xmark"></i></a>
        </div>
    </div>
{% else %}
    <div class="row">
        <div class="col-12">Pas d'agence actuellement</div>
    </div>
{% endfor %}