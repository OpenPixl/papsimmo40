<section>
    <div class="row">
        <div class="col-3">
            <div class="card" id="addMedia">
                <div class="card-body p-1">
                    <h5 class="card-title">Photos</h5>
                    {{ render(controller('App\\Controller\\Gestapp\\PropertyController::Images', {'id': property.id})) }}
                    <div class="border-bottom m-2"></div>
                    <div id="setVideo">
                        {% if property.video is null %}
                            {{ render(controller('App\\Controller\\Gestapp\\VideoController::new', {'idproperty': property.id})) }}
                        {% else %}
                            {{ render(controller('App\\Controller\\Gestapp\\VideoController::show', {'id': property.video.id})) }}
                        {% endif %}
                    </div>
                </div>
            </div>

            <div id="QrcodeProperty">
                {{ include('gestapp/photo/include/qrcode.html.twig') }}
            </div>
        </div>
        <div class="col-9">
            <div class="row g-1" id="listephoto">
                {% include('gestapp/photo/_listephoto.html.twig') %}
            </div>
        </div>
    </div>
</section>




