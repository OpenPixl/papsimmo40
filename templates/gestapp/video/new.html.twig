<h3>Ajouter une vidéo</h3>
<div class="card text-dark bg-light">
    {% if property.video is null %}
        <div class="card-body p-2">
        {{ include('gestapp/video/_form.html.twig') }}
        </div>
    {% else %}
        <div class="card-body p-2">
            <p class="mb-0">Futur lien de la video</p>
        </div>
    {% endif %}
</div>


