<div class="row">
    {% if property.video is null %}
        <div class="col-12">
        {{ include('gestapp/video/_form.html.twig') }}
        </div>
    {% else %}
        <div class="col-12">
            <div class="embed-responsive embed-responsive-21by9">
                <iframe class="embed-responsive-item" src="{{ asset('/properties/'~ property.video.path ~'/'~property.video.videoName) }}"></iframe>
            </div>
        </div>
    {% endif %}
</div>


