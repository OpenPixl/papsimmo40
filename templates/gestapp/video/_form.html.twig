{{ form_start(form) }}
<div class="row">
    <div class="col-12">
        <p class="alert alert-info p-2 mb-1">
            La vidéo déposée doit être enregistrée au format MP4 en ne pas dépassée 100Mo.
        </p>
    </div>
    <div class="col-9">
        {{ form_widget(form.videoFile, {'attr': {'class': 'form-control-file form-control-sm'}}) }}
    </div>
    <div class="col-3">
        <button type="submit" id="btnAddPhoto" class="btn btn-sm btn-outline-primary">{{ button_label|default('Ajouter') }}</button>
    </div>
</div>
{{ form_end(form) }}
