{% extends 'admin.html.twig' %}

{% block title %}Video{% endblock %}

{% block content %}
    <h1>Video</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ video.id }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ video.createdAt ? video.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ video.updatedAt ? video.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>VideoName</th>
                <td>{{ video.videoName }}</td>
            </tr>
            <tr>
                <th>VideoSize</th>
                <td>{{ video.videoSize }}</td>
            </tr>
            <tr>
                <th>Position</th>
                <td>{{ video.position }}</td>
            </tr>
            <tr>
                <th>Path</th>
                <td>{{ video.path }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_gestapp_video_index') }}">back to list</a>

    <a href="{{ path('app_gestapp_video_edit', {'id': video.id}) }}">edit</a>

    {{ include('gestapp/video/_delete_form.html.twig') }}
{% endblock %}
