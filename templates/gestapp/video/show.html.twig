<div class="row mb-1 align-items-center">
    <div class="col-10">
        <h5 class="card-title">Vidéo</h5>
    </div>
    <div class="col-2">
        <p class="text-center">
            <a href="{{ path('op_gestapp_video_del', {'id':video.id}) }}" class="btn btn-sm btn-outline-dark delVideo"><i class="fa-light fa-film-slash"></i></a>
        </p>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="ratio ratio-16x9">
            <video controls class="w-100">
                <source src="{{ asset('/properties/'~ video.path ~'/'~ video.videoName) }}" type="video/mp4">
                Ton navigateur ne supporte pas la vidéo HTML5.
            </video>
        </div>
    </div>
</div>