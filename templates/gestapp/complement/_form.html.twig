<section class="property-edit">
    {{ form_start(form) }}
    <div class="row mb-1 g-1">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body p-2">
                    <div class="row">
                        <div class="col">
                            {# Bannière sur la vignette du bien #}
                            <div class="row mb-1 g-1">
                                {{ form_label(form.banner, '', {'label_attr': {'class':'col-sm-2  form-label'}}) }}
                                <div class="col-4">
                                    {{ form_widget(form.banner, {'attr': {'class': 'oneChoice'}}) }}
                                </div>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <div class="col-3">
                                        <a id="btnListBanner" href="{{ path('op_gestapp_choice_property_banner_index') }}" class="btn btn-sm btn-outline-dark openModal" data-bs-data="LISTBANNER-listes des bannières-0">Liste des bannières disponible</a>
                                        <a id="addPropertyBanner" href="{{ path('op_gestapp_choice_property_banner_new') }}" class="btn btn-sm btn-outline-dark openModal" data-bs-data="ADDBANNER-Ajout d'une bannière-0"><i class="fa-duotone fa-circle-plus"></i></a>
                                    </div>
                                {% else %}
                                    <div class="col-3">
                                        <a id="btnListBanner" href="{{ path('op_gestapp_choice_property_banner_index') }}" class="btn btn-sm btn-outline-dark openModal" data-bs-data="LISTBANNER-Listes des bannière-0">Liste des bannières disponible</a>
                                        <a id="addPropertyBanner" href="{{ path('op_gestapp_choice_property_banner_new') }}" class="btn btn-sm btn-outline-dark openModal" data-bs-data="ADDBANNER-Ajout d'une bannière-0" disabled><i class="fa-duotone fa-circle-plus"></i></a>
                                    </div>
                                {% endif %}
                            </div>
                            {# Type de bien #}
                            <div id="propertyCat" class="row g-1">
                                {{ include('gestapp/property/Step/StepOptions/_propertycat.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card text-dark border-dark">
                <div class="card-body p-2">
                    <div class="row mb-1">
                        <div class="col-12">
                            <p class="border-bottom"><b>PIECES</b></p>
                        </div>
                    </div>
                    <div class="row mb-1">
                        {# Nombre de terrasses #}
                        <div class="row mb-1">
                            {{ form_label(form.terrace, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-4">
                                {{ form_widget(form.terrace, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                        </div>
                        {# Nombre de salles d'eau #}
                        <div class="row mb-1">
                            {{ form_label(form.washroom, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-4">
                                {{ form_widget(form.washroom, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                        </div>
                        {# Nombre de salles de bain #}
                        <div class="row mb-1">
                            {{ form_label(form.bathroom, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-4">
                                {{ form_widget(form.bathroom, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                        </div>
                        {# Nombre de WC #}
                        <div class="row mb-1">
                            {{ form_label(form.wc, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-4">
                                {{ form_widget(form.wc, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                        </div>
                        {# Nombre de balcons #}
                        <div class="row mb-1">
                            {{ form_label(form.balcony, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-4">
                                {{ form_widget(form.balcony, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                        </div>
                        {# Nombre de balcons #}
                        <div class="row mb-1">
                            {{ form_label(form.otherPieces, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-8">
                                {{ form_widget(form.otherPieces, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                            <div class="w-100"></div>
                            <div class="col-12"><span class="text-muted">{{ form_help(form.otherPieces, {'attr': {'class': 'form-control form-control-sm'}}) }}</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card text-dark border-dark">
                <div class="card-body p-2">
                    <div class="row mb-1">
                        <div class="col-12">
                            <p class="border-bottom"><b>LE BIEN</b></p>
                        </div>
                    </div>
                    {# bloc House State #}
                    <div class="row mb-1">
                        {# Etat du bien avant la vente #}
                        <div class="row mb-1">
                            {{ form_label(form.propertyState, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-6">
                                {{ form_widget(form.propertyState, {'attr': {'class': 'oneChoice'}} ) }}
                            </div>
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="col-1">
                                    <a id="addHouseState" href="{{ path('op_gestapp_choice_property_state_new') }}" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'un état-0"><i class="fa-duotone fa-circle-plus"></i></a>
                                </div>
                            {% else %}
                                <div class="col-1">
                                    <a id="addHouseState" href="{{ path('op_gestapp_choice_property_state_new') }}" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'un état-0" disabled><i class="fa-duotone fa-circle-plus text-light"></i></a>
                                </div>
                            {% endif %}
                        </div>

                        {# Energie du bien #}
                        <div class="row mb-1">
                            {{ form_label(form.energies, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-6">
                                {{ form_widget(form.energies, {'attr': {'class': 'multiChoice'}}) }}
                            </div>
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="col-1">
                                    <a id="addHouseEnergy" href="{{ path('op_gestapp_choice_property_energy_new') }}" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'un type d'énergie-0"><i class="fa-duotone fa-circle-plus"></i></a>
                                </div>
                            {% else %}
                                <div class="col-1">
                                    <a id="addHouseEnergy" href="{{ path('op_gestapp_choice_property_energy_new') }}" class="btn btn-sm btn-light openModal" data-bs-data="ADDBANNER-Ajout d'un type d'énergie-0" disabled><i class="fa-duotone fa-circle-plus text-light"></i></a>
                                </div>
                            {% endif %}
                        </div>
                        {# Charge ou appel de fond #}
                        <div class="row mb-1">
                            {{ form_label(form.propertyTax, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-sm-4">
                                <div class="input-group input-group-sm">
                                    {{ form_widget(form.propertyTax, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                    <span class="input-group-text" id="basic-addon1">€</span>
                                </div>
                            </div>
                        </div>
                        {# Orientation du bien #}
                        <div class="row mb-1">
                            {{ form_label(form.propertyOrientation, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-6">
                                {{ form_widget(form.propertyOrientation, {'attr': {'class': 'oneChoice'}}) }}
                            </div>
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="col-1">
                                    <a id="addHouseOrientation" href="{{ path('op_gestapp_choice_property_orientation_new') }}" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'une orientation-0"><i class="fa-duotone fa-circle-plus"></i></a>
                                </div>
                            {% else %}
                                <div class="col-1">
                                    <a id="addHouseOrientation" href="{{ path('op_gestapp_choice_property_orientation_new') }}" class="btn btn-sm btn-light text-light openModal" data-bs-data="ADDBANNER-Ajout d'une orientation-0" disabled><i class="fa-duotone fa-circle-plus"></i></a>
                                </div>
                            {% endif %}
                        </div>
                        {# Disponibilité du bien #}
                        <div class="row mb-1">
                            {{ form_label(form.disponibility, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-6">
                                {{ form_widget(form.disponibility , {'attr': {'class': 'oneChoice'}}) }}
                            </div>
                        </div>
                        {# Location à partir de #}
                        <div class="row mb-1">
                            {{ form_label(form.location, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-6">
                                {{ form_widget(form.location, {'attr': {'class': 'oneChoice'}}) }}
                            </div>
                        </div>
                        {# Date de disponibilité ou de location #}
                        <div class="row mb-1">
                            {{ form_label(form.disponibilityAt, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                            <div class="col-sm-3">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon1"><i class="fa-duotone fa-calendar-days"></i></span>
                                    {{ form_widget(form.disponibilityAt, {'attr': {'class': 'form-control form-control-sm flatpickr'}}) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-5">
            <div class="card text-dark border-dark">
                <div class="card-body p-2">
                    <div class="row mb-1">
                        <div class="col-12">
                            <p class="border-bottom"><b>EQUIPEMENTS</b></p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-check form-check-inline">
                            <dl class="row">
                                <dd class="col-4">
                                    {{ form_label(form.isFurnished, '', {'label_attr': {'class':'form-check-label'}}) }}
                                </dd>
                                <dd class="col-2">
                                    {% for child in form.isFurnished %}
                                        {{ form_widget(child) }}
                                        {{ form_label(child) }}
                                    {% endfor %}
                                </dd>
                            </dl>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-check form-check-inline">
                            <dl class="row">
                                <dd class="col-4">
                                    {{ form_label(form.coproperty, '', {'label_attr': {'class':'form-check-label'}}) }}
                                </dd>
                                <dd class="col-2">
                                    {% for child in form.coproperty %}
                                        {{ form_widget(child) }}
                                        {{ form_label(child) }}
                                    {% endfor %}
                                </dd>
                                <dd class="col-4">
                                    <div id="coproprietyTaxe" class="input-group input-group-sm d-none">
                                        {{ form_widget(form.coproprietyTaxe, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                        <span class="input-group-text" id="basic-addon1">€</span>
                                    </div>
                                </dd>
                            </dl>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-check form-check-inline">
                            <dl class="row">
                                <dd class="col-4">
                                    {{ form_label(form.jointness, '', {'label_attr': {'class':'form-check-label'}}) }}
                                </dd>
                                <dd class="col-2">
                                    {% for child in form.jointness %}
                                        {{ form_widget(child) }}
                                        {{ form_label(child) }}
                                    {% endfor %}
                                </dd>
                            </dl>
                        </div>
                    </div>
                    {# Equipement du bien #}
                    <div class="row mb-1">
                        {{ form_label(form.propertyEquipment, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                        <div class="col-6">
                            {{ form_widget(form.propertyEquipment, {'attr': {'class': 'multiChoice'}}) }}
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="col-1">
                                <a id="addHouseEquipment" href="{{ path('op_gestapp_choice_property_equipement_new') }}" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'un équipement-0"><i class="fa-duotone fa-circle-plus"></i></a>
                            </div>
                        {% else %}
                            <div class="col-1">
                                <a id="addHouseEquipment" href="{{ path('op_gestapp_choice_property_equipement_new') }}" class="btn btn-sm btn-light openModal" data-bs-data="ADDBANNER-Ajout d'un équipement-0" disabled><i class="fa-duotone fa-circle-plus text-light"></i></a>
                            </div>
                        {% endif %}
                    </div>
                    {# Typologie du bien #}
                    <div class="row mb-1">
                        {{ form_label(form.propertyTypology, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                        <div class="col-6">
                            {{ form_widget(form.propertyTypology, {'attr': {'class': 'oneChoice'}}) }}
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="col-1">
                                <a id="addHouseTypology" href="{{ path('op_gestapp_choice_property_typology_new') }}" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'une bannière-0"><i class="fa-duotone fa-circle-plus"></i></a>
                            </div>
                        {% else %}
                            <div class="col-1">
                                <a id="addHouseTypology" href="{{ path('op_gestapp_choice_property_typology_new') }}" class="btn btn-sm btn-light openModal" data-bs-data="ADDBANNER-Ajout d'une bannière-0" disabled><i class="fa-duotone fa-circle-plus text-light"></i></a>
                            </div>
                        {% endif %}
                    </div>
                    {# Etage du bien #}
                    {# Nombre d'étage #}
                    <div class="row mb-1">
                        {{ form_label(form.level, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                        <div class="col-4">
                            {{ form_widget(form.level, {'attr': {'class': 'form-control form-control-sm'}}) }}
                        </div>
                    </div>
                    {# Typologie du bien #}
                    <div class="row mb-1">
                        {{ form_label(form.propertyOtheroption, '', {'label_attr': {'class':'col-sm-4  form-label'}}) }}
                        <div class="col-6">
                            {{ form_widget(form.propertyOtheroption, {'attr': {'class': 'multiChoice'}}) }}
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="col-1">
                                <a id="addHouseOtheroption" href="{{ path('op_gestapp_choice_other_option_new') }}" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'une option-0"><i class="fa-duotone fa-circle-plus"></i></a>
                            </div>
                        {% else %}
                            <div class="col-1">
                                <a id="addHouseOtheroption" href="{{ path('op_gestapp_choice_other_option_new') }}" class="btn btn-sm btn-light openModal" data-bs-data="ADDBANNER-Ajout d'une option-0" disabled><i class="fa-duotone fa-circle-plus text-light"></i></a>
                            </div>
                        {% endif %}
                    </div>

                </div>
            </div>

        </div>
    </div>
    {{ form_rest(form) }}
    {{ form_end(form) }}
</section>