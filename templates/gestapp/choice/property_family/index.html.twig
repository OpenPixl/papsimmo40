<div id="listFamily">
    <table class="table table-sm table-hover">
        <thead>
        <tr>
            <th>Nom</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
            <tr>
                <td>Ajouter</td>
                <td></td>
            </tr>
        {% for property_family in property_families %}
            <tr>
                <td>{{ property_family.name }} <small>({{ property_family.code }})</small></td>
                <td></td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
