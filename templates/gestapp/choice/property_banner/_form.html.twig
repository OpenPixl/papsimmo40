{{ form_start(form, {'attr': {'id': 'FormPropertyBanner'}}) }}
<div class="modal-body p-2">
    <p class="alert alert-warning p-2"><b>Attention :</b><br>Pour l'illustration de la bannière, seule les images au format SVG seront prise en compte.</p>
    <div class="row mb-1">
        <div class="col-4">{{ form_label(form.name) }}</div>
        <div class="col-8">{{ form_widget(form.name, {'attr': {'class': 'form-control form-control-sm'}}) }}</div>
    </div>
    <div class="row mb-1">
        <div class="col-4">{{ form_label(form.banner) }}</div>
        <div class="col-8">{{ form_widget(form.banner, {'attr': {'class': 'form-control form-control-sm'}}) }}</div>
    </div>
</div>
{{ form_end(form) }}