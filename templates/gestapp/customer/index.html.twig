{% extends 'admin.html.twig' %}

{% block title %}Customer index{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block contentTitle %}
    <div class="row">
        <div class="col-sm-12">
            <h1 class="fs-4 border-bottom border-dark fw-normal">TRANSACTION - Liste des Clients</h1>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="row justify-content-end mt-1 mb-1">
        <div class="col-6 d-inline-flex">
            <a class="btn btn-sm btn-outline-primary" href="{{ path('op_gestapp_customer_new') }}"><i class="fa-duotone fa-user-plus"></i> Ajouter un nouveau client ou nouvelle cliente.</a>
            {{ render(controller('App\\Controller\\Admin\\SearchController::customerOnIndex')) }}
        </div>
        <div class="col-6 d-flex justify-content-end" id="blockPagination">
            {{ knp_pagination_render(customers, 'include/admin/pagination.html.twig') }}
        </div>
    </div>
    <div class="row">
        <div class="col-12" id="liste">
            {% include('gestapp/customer/include/_list.html.twig') %}
        </div>
    </div>
{% endblock %}
