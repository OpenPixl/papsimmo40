<div class="row mt-1">
    <div class="col-12">
        <div class="card border-info">
            <div class="card-body p-2">
                <div class="row">
                    <div class="col-12" id="liste_research">
                        <p class="border-bottom mb-1 text-uppercase"><b>Demande de recherches</b></p>
                        {% for r in customer.research %}
                            <div class="row mb-1">
                                <div class="col-12">
                                    <p class="ps-1 mb-0 alert alert-light p-2">
                                        {{ loop.index }} -
                                        <a href="{{ path('op_gestapp_customer_research_edit', {'id':r.id}) }}" class="btnOpenModal text-uppercase" data-bs-data="EDIT_Research-Demande de recherche de bien">{{ r.researchFor }}</a> |
                                        recherche pour : {{ r.typeProject }}
                                    </p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>