{{ form_start(form) }}
    <div class="row">
        <div class="col-12">
            <p class="mb-2">Cette fiche est réalisée dans le cadre de la démarche commerciale entre vous et le client.</p>
        </div>
        <div class="col-12">
            <div class="card border-dark mb-1">
                <div class="card-body p-2">
                    <p class="border-bottom"><b>INFORMATIONS SUR LA RECHERCHE</b></p>
                    <div class="row g-1 mt-1 mb-1">
                        <div class="col-3 d-flex align-items-center">
                            {{ form_label(form.ResearchBien, '- Le client recherche quel type de bien ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-3 d-flex align-items-center">
                            {{ form_widget(form.ResearchBien, {'attr': {'class': 'form-select form-select-sm'}}) }}
                        </div>
                        <div class="col-1"></div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_label(form.researchFor, 'Pour ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-3 d-flex align-items-center">
                            {% for label, value, choice in field_choices(form.researchFor) %}
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="{{ field_name(form.researchFor) }}" id="{{ field_name(form.researchFor) }}{{ value }}" value="{{ value }}" {% if value is same as research.researchFor %}checked="checked"{% endif %}>
                                    <label class="form-check-label" for="{{ field_name(form.researchFor) }}{{ value }}">{{ label }}</label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="row g-1 mt-1">
                        <div class="col-3 d-flex align-items-center">
                            {{ form_label(form.typeProject, '- Pour quel type de projet ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-9  d-flex align-items-center">
                            {% for label, value, choice in field_choices(form.typeProject) %}
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="{{ field_name(form.typeProject) }}" id="{{ field_name(form.typeProject) }}{{ value }}" value="{{ value }}" {% if value is same as research.typeProject %}checked="checked"{% endif %}>
                                    <label class="form-check-label" for="{{ field_name(form.typeProject) }}{{ value }}">{{ label }}</label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="row g-1 mt-1">
                        <div class="col-3 d-flex align-items-center">
                            {{ form_label(form.budgetMin, '- Pour quel budget ?', {'label_attr': {'class':'form-label'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.budgetMin, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Min'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.budgetMax, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Max'}}) }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-dark mb-1">
                <div class="card-body p-2">
                    <p class="border-bottom"><b>DETAILS SUR LA RECHERCHE</b></p>
                    <div class="row g-1 mt-1">
                        <div class="col-2 d-flex align-items-center">
                            {{ form_label(form.pieceMin, '- Pièces ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.pieceMin, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Min'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.pieceMax, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Max'}}) }}
                        </div>
                        <div class="col-1"></div>
                        <div class="col-2 d-flex align-items-center">
                            {{ form_label(form.roomMin, '- Chambres ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.roomMin, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Min'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.roomMax, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Max'}}) }}
                        </div>
                    </div>
                    <div class="row g-1 mt-1">
                        <div class="col-2 d-flex align-items-center">
                            {{ form_label(form.surfaceMin, '- Surface habitable ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.surfaceMin, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Min'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.surfaceMax, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Max'}}) }}
                        </div>
                        <div class="col-1"></div>
                        <div class="col-2 d-flex align-items-center">
                            {{ form_label(form.surfaceLandMin, '- surface de terrain ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.surfaceLandMin, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Min'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.surfaceLandMax, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Max'}}) }}
                        </div>
                    </div>
                    <div class="row g-1 mt-1">
                        <div class="col-2 d-flex align-items-center">
                            {{ form_label(form.energies, '- Energies ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.energies, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Min'}}) }}
                        </div>
                        <div class="col-1"></div>
                        <div class="col-2 d-flex align-items-center">
                            {{ form_label(form.options, '- Options ?', {'label_attr': {'class':'form-label mb-0'}}) }}
                        </div>
                        <div class="col-1 d-flex align-items-center">
                            {{ form_widget(form.options, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Min'}}) }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-dark mb-1">
                <div class="card-body p-2">
                    <p class="border-bottom"><b>NOTES</b></p>
                    <div class="row">
                        <div class="col-12">
                            {{ form_widget(form.notes, {'attr': {'class': 'form-control form-control-sm tinymce', 'placeholder':"Description de l'annonce", 'rows' : 8}}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ form_widget(form) }}
{{ form_end(form) }}
