
{{ form_start(form, {'attr': {'id': 'FormEditCustomer'}}) }}

<div class="row g-1">
    <div class="col-12">
        {% if customer.finished == 0 %}
        <p class="alert alert-warning p-2">
            Cette fiche client est en cours de création.
        </p>
        {% endif %}
        <div class="card ext-dark bg-light mb-1">
            <div class="card-body p-2">
                <div class="row align-items-center">
                    <div class="col-2">
                        <p class="mb-0"><b>LE CLIENT EST UN :</b></p>
                    </div>
                    <div class="col-2">
                        {{ form_widget(form.typeClient, {'attr': {'class': 'form-select form-select-sm'}}) }}
                    </div>
                    <div class="col-3">
                        <p class="mb-0">
                            <b>RELATION COMMERCIALE AVEC LE CLIENT :</b>
                        </p>
                    </div>
                    <div class="col-2">
                        {{ form_widget(form.customerChoice, {'attr': {'class': 'form-select form-select-sm'}}) }}
                    </div>
                    <div class="col-3">
                        {{ form_label(form.isArchived, '', {'label_attr': {'class':'form-label mb-0'}}) }}
                        {{ form_widget(form.isArchived) }}
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="col-12">
        <div id="box_particulier" class="card border-dark">
            <div class="card-body">
                <div class="row">
                    <div class="col-8">
                        <p class="border-bottom mb-1"><b>INFORMATIONS DU CLIENT</b></p>
                        <div class="row align-items-center g-1 mb-1">
                            <div class="col-2">
                                {{ form_label(form.civility, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-3">
                                {% for label, value, choice in field_choices(form.civility) %}
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="{{ field_name(form.civility) }}" id="{{ field_name(form.civility) }}{{ value }}" value="{{ value }}" {% if value is same as customer.civility %}checked="checked"{% endif %}>
                                        <label class="form-check-label" for="{{ field_name(form.civility) }}{{ value }}">{{ label }}</label>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="row align-items-center g-1 mb-1">
                            <div class="col-2">
                                {{ form_label(form.firstName, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-2">
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Prénom complet ...'}}) }}
                            </div>
                            <div class="col-3 d-none">
                                {{ form_widget(form.maidenName, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Nom de jeune fille ...'}}) }}
                            </div>
                            <div class="col-3">
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Nom complet ...'}}) }}
                            </div>
                        </div>
                        <div class="row align-items-center g-1 mb-1 pb-1 border-bottom">
                            <div class="col-2">
                                {{ form_label(form.ddn, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-2">
                                {{ form_widget(form.ddn, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                            <div class="col-3">
                                {{ form_widget(form.ddnIn, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                        </div>
                        <div class="row align-items-center g-1 mb-1 pb-1 border-bottom">
                            <div class="col-2">
                                {{ form_label(form.adress, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-6">
                                {{ form_widget(form.adress, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Adresse ...'}}) }}
                            </div>
                            <div class="w-100"></div>
                            <div class="offset-2 col-6 mt-0">
                                {{ form_widget(form.complement, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'complément ...'}}) }}
                            </div>
                            <div class="w-100"></div>
                            <div class="offset-2 col-2 mt-0">
                                {{ form_widget(form.zipcode, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Ville/Commune ...'}}) }}
                            </div>
                            <div class="col-4 mt-0">
                                {{ form_widget(form.city, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Commune'}}) }}
                                <select id="customer_selectcity" class="form-select form-select-sm">
                                    <option>{{ form.zipcode.vars.data }} - {{ form.city.vars.data }}</option>
                                </select>
                            </div>
                        </div>
                        <div class="row align-items-center g-1 mb-1">
                            <div class="col-2">
                                Contacts
                            </div>
                            <div class="col-3">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon1"><i class="fa-duotone fa-phone-plus"></i></span>
                                    {{ form_widget(form.home, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Domicile ...'}}) }}
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon1"><i class="fa-duotone fa-mobile"></i></span>
                                    {{ form_widget(form.gsm, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Portable ...'}}) }}
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon1"><i class="fa-duotone fa-phone-office"></i></span>
                                    {{ form_widget(form.desk, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Bureau ...'}}) }}
                                </div>
                            </div>
                        </div>
                        <div class="row align-items-center g-1 mb-1">
                            <div class="col-2">
                                {{ form_label(form.otherEmail, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-6">
                                {{ form_widget(form.otherEmail, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Email ...'}}) }}
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <p class="border-bottom mb-1"><b>PIECES A FOURNIR</b></p>
                        <p class="mb-0">Pour la validité du dossier, veuillez fournir les pièces demandées au format <b>JPEG</b> ou <b>PDF</b>.</p>
                        <div id="ci" class="row mt-1">
                            <div class="col-12">
                                <i class="fa-solid fa-arrow-right"></i> Déposez la pièce d'identité du client.
                            </div>
                            <div class="col-12">
                                {{ form_widget(form.cifilename, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                            {% if customer.cifilename is not empty %}
                                <div class="col-12 mt-1">
                                    <a class="btn btn-sm btn-outline-dark" href="{{ asset('customer/'~customer.lastName~'_'~customer.firstName~'/'~customer.cifilename) }}" download>Télécharger la pièce d'identité</a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="box_professionnel" class="card border-dark d-none">
            <div class="card-body">
                <div class="row">
                    <div class="col-8">
                        <p class="border-bottom mb-1"><b>INFORMATIONS DU CLIENT</b></p>
                        <div class="row align-items-center g-1 mb-1">
                            <div class="col-2">
                                {{ form_label(form.nameStructure, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-3">
                                {{ form_widget(form.nameStructure, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Nom complet ...'}}) }}
                            </div>
                            <div class="col-2"></div>
                            <div class="col-2">
                                {{ form_label(form.typeStructure, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-3">
                                {{ form_widget(form.typeStructure, {'attr': {'class': 'form-select form-select-sm'}}) }}
                            </div>
                        </div>
                        <div class="row align-items-center g-1 mb-2 pb-1">
                            <div class="col-2">
                                {{ form_label(form.proAdress, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-6">
                                {{ form_widget(form.proAdress, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Adresse ...'}}) }}
                            </div>
                            <div class="w-100"></div>
                            <div class="offset-2 col-6 mt-0">
                                {{ form_widget(form.proComplement, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'complément ...'}}) }}
                            </div>
                            <div class="w-100"></div>
                            <div class="offset-2 col-2 mt-0">
                                {{ form_widget(form.proZipcode, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Ville/Commune ...'}}) }}
                            </div>
                            <div class="col-4 mt-0">
                                {{ form_widget(form.proCity, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Commune'}}) }}
                                <select id="customer_proSelectcity" class="form-select form-select-sm">
                                    <option>{{ form.proZipcode.vars.data }} - {{ form.proCity.vars.data }}</option>
                                </select>
                            </div>
                        </div>
                        <div class="row align-items-center g-1 mb-1">
                            <div class="col-2">
                                Contacts
                            </div>
                            <div class="col-3">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon1"><i class="fa-duotone fa-mobile"></i></span>
                                    {{ form_widget(form.gsmStructure, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Portable ...'}}) }}
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="input-group">
                                    <span class="input-group-text" id="basic-addon1"><i class="fa-duotone fa-phone-office"></i></span>
                                    {{ form_widget(form.deskStructure, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Bureau ...'}}) }}
                                </div>
                            </div>
                        </div>
                        <div class="row align-items-center g-1 mb-1">
                            <div class="col-2">
                                {{ form_label(form.EmailStructure, '', {'label_attr': {'class':'form-label'}}) }}
                            </div>
                            <div class="col-6">
                                {{ form_widget(form.EmailStructure, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Email de la structure...'}}) }}
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <p class="border-bottom mb-1"><b>PIECES A FOURNIR</b></p>
                        <p class="mb-0">Pour la validité du dossier, veuillez fournir les pièces demandées au format <b>JPEG</b> ou <b>PDF</b>.</p>
                        <div id="kbis" class="row mt-1 mb-1 g-1">
                            <div class="col-12">
                                Extrait Kbis à fournir
                            </div>
                            <div class="col-12">
                                {{ form_widget(form.kbisfilename, {'attr': {'class': 'form-control form-control-sm'}}) }}
                            </div>
                            {% if customer.kbisfilename is not empty %}
                                <div class="col-12">
                                    <a class="btn btn-sm btn-outline-dark" href="{{ asset('customer/'~customer.lastName~'_'~customer.firstName~'/'~customer.kbisfilename) }}" download>Télécharger la pièce d'identité</a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    {{ form_end(form) }}
                    <div class="col-8">
                        <div class="row align-items-center g-1 mb-1">
                            <div class="col-12">
                                <p class="border-bottom mb-1"><b>RESPONSABLES DE LA STRUCTURE</b></p>
                            </div>
                            <div class="col-12">
                                {{ render(controller('App\\Controller\\Gestapp\\CustomerController::addRespStructjson', {'id': customer.id})) }}
                                <div id="liste_respcustomer">
                                    {{ include('gestapp/customer/include/liste_respcustomer.html.twig') }}
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="mt-3">
    <a class="btn btn-sm btn-outline-dark" href="{{ path('op_gestapp_customer_index') }}">
        <i class="fa-solid fa-backward-step"></i> Retour à la liste de clients
    </a>
    {% if customer.finished == 1 %}
        <button type="submit" id="btnAddCustomer" class="btn btn-sm btn-outline-primary">{{ button_label|default("Créer la fiche") }}</button>
    {% else %}
        <button type="submit" id="btnAddCustomer" class="btn btn-sm btn-outline-warning">{{ button_label|default("Créer la fiche") }}</button>
    {% endif %}
</div>
