{% extends 'admin.html.twig' %}

{% block title %}Edit Customer{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/gestapp/customer/new_edit.js') }}"></script>
{% endblock %}

{% block contentTitle %}
    <div class="row">
        <div class="col-sm-12">
            <h1 class="fs-4 border-bottom border-dark fw-normal">TRANSACTIONS - Edition fiche du client</h1>
        </div>
    </div>
{% endblock %}

{% block content %}
<section class="row mb-5">
    <div class="col-12">
        <div class="row">
            <div class="col-12">
                {% set formErrors = form.vars.errors.form.getErrors(true) %}
                {% if formErrors|length %}
                    <ul>
                        {% for error in formErrors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                {{ include('gestapp/customer/_form.html.twig', {'button_label': 'Mettre à jour la fiche du client'}) }}
            </div>
        </div>
    </div>
</section>

{% endblock %}
