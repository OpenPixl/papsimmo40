{% if idproperty is defined %}
<div class="row">
    <div class="col-12">
        <p><b>Rechercher</b> un client pour l'ajouter au mandat en cours</p>
    </div>
</div>
{% endif %}
{{ form_start(form) }}
<div class="row">
    <div class="col-12">
        <div class="input-group input-group-sm mb-1">
            <span class="input-group-text" id="basic-addon1"><i class="fa-light fa-magnifying-glass"></i></span>
            {{form_widget(form.firstName, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'Entrez le nom du client recherché'} })}}

        </div>
    </div>
</div>
{{ form_end(form) }}
{% if idtransaction is defined %}
    <div class="row g-1" id="listeSearchCustomers"></div>
{% endif %}