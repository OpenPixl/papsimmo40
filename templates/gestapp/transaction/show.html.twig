{% extends 'admin.html.twig' %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item active"><a href="/opadmin/dashboard"><svg class="svg-inline--fa fa-house-blank" aria-hidden="true" focusable="false" data-prefix="fad" data-icon="house-blank" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" data-fa-i2svg=""><g class="fa-duotone-group"><path class="fa-secondary" fill="currentColor" d="M64 270.5c74.7-65.3 149.3-130.6 224-196L512.1 270.6l.4 177.3c.1 35.4-28.6 64.1-64 64.1l-320.4 0c-35.3 0-64-28.6-64-64L64 270.5z"></path><path class="fa-primary" fill="currentColor" d="M266.9 7.9C279-2.6 297-2.6 309.1 7.9l256 224c13.3 11.6 14.6 31.9 3 45.2s-31.9 14.6-45.2 3L288 74.5 53.1 280.1c-13.3 11.6-33.5 10.3-45.2-3s-10.3-33.5 3-45.2l256-224z"></path></g></svg><!-- <i class="fa-duotone fa-house-blank"></i> --> Tableau de Bord</a></li>
        <li class="breadcrumb-item active">Transaction</li>
        <li class="breadcrumb-item active"><a href="{{ path('op_gestapp_transaction_index') }}">Transactions</a></li>
        <li class="breadcrumb-item active">Fiche {{ transaction.name }}</li>
    </ol>
{% endblock %}

{% block contentTitle %}
    <div class="row d-flex justify-content-between">
    <div class="col-sm-12">
        <h1 class="fs-3 border-bottom border-dark fw-normal">TRANSACTION - Ref : {{ transaction.name }}</h1>
        <input id="valueProperty" type="hidden" value="{{ transaction.id }}">
    </div>
    </div>
{% endblock %}

{% block content %}
<div class="row mb-5 align-items-top g-2">
    <div class="col-3">
        {{ include('gestapp/transaction/show/cardInformations.html.twig') }}
        {{ include('gestapp/transaction/show/cardCollaborateurs.html.twig') }}

        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <div class="card border-dark mt-2" id="blockAgencyEmployed">
                <div class="card-body p-2">
                    {{ include('gestapp/transaction/add_agencyemployed/index.html.twig') }}
                </div>
            </div>
        {% endif %}
    </div>
    <div class="col-9">
        <div class="row  mb-2">
            <div class="col-4 justify-content-end" id="btnsTransaction">
                <a href="{{ path('op_gestapp_transaction_addcustomerjson', {'id': transaction.id }) }}" class="btn btn-sm btn-outline-dark openModal" data-bs-data="ADDBUYERS-Ajouter un acheteur"><i class="fa-duotone fa-light fa-plus"></i> Acheteur</a>
                <a href="{{ path('op_gestapp_transaction_addappointment', {'id': transaction.id }) }}" class="btn btn-sm btn-outline-dark openModal {% if transaction.customer|length == 0 %}disabled{% else %}{% endif %}" data-bs-data="ADDAPPOINTMENT-Ajouter une date"><i class="fa-duotone fa-light fa-plus"></i> Date de RDV</a>
                <a href="#" class="btn btn-sm btn-outline-dark openModal {% if transaction.customer|length == 0 and transaction.dateAtPromise is null %}disabled{% else %}{% endif %}" data-bs-data="Add_Buyers-Ajouter un document"><i class="fa-duotone fa-light fa-plus"></i> Document</a>
            </div>
        </div>
        <div class="card border-primary mb-2">
            <div class="card-body p-2">
                <p class="border-bottom mb-0"><b>Etat d'avancement du dossier</b></p>
                <div class="row ">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-9">
                                {% if transaction.state == 'finished' %}
                                    <p class="mb-0 text-primary"><i class="fa-duotone fa-light fa-circle-check"></i> Ce dossier de vente est finalisé.</p>
                                {% else %}
                                    <p class="mb-0 text-primary"><i class="fa-duotone fa-light fa-circle-exclamation"></i> Ce dossier de vente est en cours de construction.</p>
                                {% endif %}
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="card border-dark mb-2">
            <div class="card-body p-2" id="Block_Buyers">
                {{ include('gestapp/transaction/show/buyers.html.twig') }}
            </div>
        </div>
        <div class="card border-dark mb-2">
            <div class="card-body p-2" id="Block_Appointment">
                {{ include('gestapp/transaction/show/_appointment.html.twig') }}

            </div>
        </div>
        <div class="card border-dark mb-2">
            <div class="card-body p-2" id="Block_Documents">
                {{ transaction.isDocsFinished }} {{ transaction.isClosedfolder }}
                <p class="border-bottom mb-0"><b>Documents</b></p>
                {% include 'gestapp/transaction/show/_document.html.twig' with {
                    'documentValid' : transaction.isValidPromisepdf,
                    'typeDocument' : 'Promesse de vente',
                    'nameDocument' : transaction.promisePdfFilename,
                    'url': '',
                    'message' : 'message'
                } %}
                {% include 'gestapp/transaction/show/_document.html.twig' with {
                    'documentValid' : '',
                    'typeDocument' : 'Honoraires',
                    'nameDocument' : transaction.honorairesPdfFilename,
                    'url': '',
                    'message' : 'message'
                } %}
                {% include 'gestapp/transaction/show/_document.html.twig' with {
                    'documentValid' : transaction.isValidActepdf,
                    'typeDocument' : 'Attestation de l\'acte',
                    'nameDocument' : transaction.actePdfFilename,
                    'url': '',
                    'message' : 'message'
                } %}
                {% include 'gestapp/transaction/show/_document.html.twig' with {
                    'documentValid' : transaction.isValidtracfinPdf,
                    'typeDocument' : 'TRACFIN',
                    'nameDocument' : transaction.tracfinPdfFilename,
                    'url': '',
                    'message' : 'message'
                } %}

            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block contentFooter %}{% endblock %}