<p class="border-bottom mb-1"><b>Acquéreurs</b></p>
{% for customer in transaction.customer %}
    <div class="alert alert-light mb-1 p-2">
        <div class="d-flex justify-content-between">
            <div>
                <p class="mb-0">
                    {{ loop.index }} |
                    {% if customer.typeClient == "professionnel" %}
                        {{ customer.nameStructure }} | {{ customer.gsmStructure }}
                    {% else %}
                        {% if customer.civility ==2 %}Mme. {% else %}M. {% endif %}{{ customer.firstname }} {{ customer.lastName }} |
                        {% if customer.gsm is defined %}{{ customer.gsm }}{% endif %}
                        {% if customer.home is defined %}{{ customer.home }}{% endif %}
                    {% endif %}
                    {% if customer.typeClient == "professionnel" %}
                        | {{ customer.proZipcode }} {{ customer.proCity }}
                    {% else %}
                        | {{ customer.zipcode }} {{ customer.city }}
                    {% endif %}
                </p>
            </div>
            <div>
                <p class="mb-0">
                    {% if access == "edit" %}
                        <a href="#" class="text-info" data-bs-toggle="modal" data-bs-target="#modalCustomer" data-bs-whatever="EDIT-Modifier un acheteur-{{ transaction.id }}"><i class="fa-duotone fa-user-pen"></i></a>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                        {% endif %}
                    {% else %}
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <a href="{{ path('op_gestapp_transaction_editcustomerjson', {'id': transaction.id, 'buyer': customer.id}) }}" class="text-info openModal" data-bs-data="EDITBUYERS-Modifier un acheteur-{{ transaction.id }}"><i class="fa-duotone fa-user-pen"></i></a> |
                            <a href="{{ path('op_gestapp_transaction_delcustomerjson', {'id': transaction.id, 'idCustomer': customer.id}) }}" class="text-danger openModal" data-bs-data="Del_Buyers-Suppression de l'acheteur"><i class="fa-duotone fa-trash-can"></i></a>
                        {% else %}
                        {% endif %}
                    {% endif %}
                </p>
            </div>
        </div>
    </div>
{% else %}
    <div class="alert alert-light mb-1 p-2">
        <div class="d-flex justify-content-between">
            <div>
                <p class="mb-0">
                    Le dossier ne fait pas remonter d'acquéreur
                </p>
            </div>
        </div>
    </div>
{% endfor %}