<dl class="row g-1 align-items-center mb-1" >
    <dt class="col-sm-2 mb-0">
        {% if documentValid == 1 %}
            <span class="text-success"><i class="fa-duotone fa-light fa-shield-check"></i></span>
        {% else %}
            <span class="text-warning"><i class="fa-duotone fa-light fa-circle-dashed"></i></span>
        {% endif %}
        {{ typeDocument }} :
    </dt>
    <dd class="col-sm-4 mb-0"> {{ nameDocument }}</dd>
    <dd class="col-sm-3 mb-0">
        <a href="#" class="text-primary text-decoration-none"><i class="fa-duotone fa-light fa-arrow-down-to-line"></i> Télécharger </a>
        {% if transaction.isDocsFinished == 0 %}
            {% if access == "read" %}
                 | <a href="#" class="text-primary text-decoration-none"><i class="fa-duotone fa-light fa-eye"></i> Voir </a>
            {% else %}
                 | <a href="#" class="text-primary text-decoration-none"><i class="fa-light fa-arrows-rotate"></i> Actualiser le document </a>
            {% endif %}
        {% endif %}
    </dd>
    {% if access == "admin" %}
    <dd class="col-sm-1 mb-0">
        <a href="#" class="text-warning text-decoration-none"><i class="fa-duotone fa-light fa-trash-can-xmark"></i> Supprimer </a>
    </dd>
    {% endif %}
</dl>