
<div class="card-body p-2">
    <div class="row">
        {% if access == 'read' %}
            <div class="col-9"><h5 class="mb-0">Ajouter un collaborateur</h5></div>
            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <div class="col-3">
                    <p class="mb-0 text-center">
                        <a id="btnAddCollaborator" href="{{ path('op_gestapp_transaction_addcollaborator_add', {'idtransac': transaction.id})}}" class="openModal" data-bs-data="ADDCOLLAB-Ajout d'un collaborateur-FormAddcollaborator"><i class="fa-duotone fa-user-plus fa-2x"></i></a>
                    </p>
                </div>
            {% endif %}
        {% else %}
            {% if access == 'admin' or access == 'edit' %}
                <div class="col-9"><h5 class="mb-0">Ajouter un collaborateur</h5></div>
                <div class="col-3">
                    <p class="text-center mb-0">
                        <a id="btnAddCollaborator" href="{{ path('op_gestapp_transaction_addcollaborator_add', {'idtransac': transaction.id})}}" class="openModal" data-bs-data="ADDCOLLAB-Ajout d'un collaborateur-FormAddcollaborator"><i class="fa-duotone fa-user-plus fa-2x"></i></a>
                    </p>
                </div>
            {% else %}
                <div class="col-9"><h5>Liste des collaborateurs</h5></div>
            {% endif%}
        {% endif %}
    </div>
    <div id="listCollaborator" class="mt-1">
    {% if transaction.addCollTransacs|length > 0 %}
        {% set listcollaborators = transaction.addCollTransacs %}

            {% include 'gestapp/transaction/show/_listCollaborator.html.twig' with listcollaborators %}
    {% endif %}
    </div>
</div>
