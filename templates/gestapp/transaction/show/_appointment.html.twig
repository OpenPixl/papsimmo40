<p class="border-bottom mb-1"><b>Dates</b></p>
<p class="mb-0">Ouverture de dossier : <span class="text-primary">{{ transaction.createdAt|format_datetime('full', 'none', locale='fr') }}</span> <a href="#" class="text-primary"><i class="fa-duotone fa-light fa-check"></i></a></p>
<p class="mb-0">Signature du compromis :
    {% if transaction.dateAtPromise %}
    <span class="text-primary">{{ transaction.dateAtPromise|format_datetime('full', 'none', locale='fr') }}</span>
    <a href="#" class="text-primary"><i class="fa-light fa-arrows-rotate"></i></a></p>
{% else %}
    <span class="text-primary"><em>Non défini</em></span>
                    {% endif %}
<p class="mb-0">Signature de l'acte :
    {% if transaction.dateAtSale %}
        <span class="text-primary"> {{ transaction.dateAtSale|format_datetime('full', 'none', locale='fr') }} </span>
        <a href="#" class="text-primary"><i class="fa-light fa-arrows-rotate"></i></a>
    {% else %}
        <span class="text-primary"><em>Non défini</em></span>
    {% endif %}
</p>