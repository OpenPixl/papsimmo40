<p class="border-bottom mb-1"><b>Dates</b></p>
<dl class="row g-1 align-items-center mb-1">
    <dt class="col-sm-3 mb-0">
        {% if transaction.createdAt %}
            <span class="text-success"><i class="fa-duotone fa-light fa-shield-check"></i></span>
        {% else %}
            <span class="text-warning"><i class="fa-duotone fa-light fa-circle-dashed"></i></span>
        {% endif %}
        Ouverture de dossier :
    </dt>
    <dd class="col-sm-3 mb-0"><span class="text-primary">{{ transaction.createdAt|format_datetime('full', 'none', locale='fr') }}</span></dd>
</dl>
<dl class="row g-1 align-items-center mb-1">
    <dt class="col-sm-3 mb-0">
        {% if transaction.dateAtPromise %}
            <span class="text-success"><i class="fa-duotone fa-light fa-shield-check"></i></span>
        {% else %}
            <span class="text-warning"><i class="fa-duotone fa-light fa-circle-dashed"></i></span>
        {% endif %}
        Signature du compromis :
    </dt>
    {% if transaction.dateAtPromise %}
        <dd class="col-sm-3 mb-0"><span class="text-primary">{{ transaction.dateAtPromise|format_datetime('full', 'none', locale='fr') }}</span></dd>
        <dd class="col-sm-3 mb-0"><a href="{{ path('op_gestapp_transaction_editappointment', {'id':transaction.id, 'appointment': 'dateAtPromise'}) }}" class="text-primary openModal" data-bs-data="EDITAPPOINTMENT-Modifier du RDV-dateAtPromise"><i class="fa-light fa-arrows-rotate"></i> Actualiser la date</a></dd>
    {% else %}
        <dd class="col-sm-3 mb-0"><span class="text-primary"><em>Non défini</em></span></dd>
        <dd class="col-sm-3 mb-0"></dd>
    {% endif %}
    {% if access == 'admin' and transaction.dateAtPromise is not null %}
        <dd class="col-sm-1 mb-0">
            <a href="{{ path('op_gestapp_transaction_delappointment', {'id':transaction.id, 'appointment': 'dateAtPromise'}) }}" class="text-danger text-decoration-none openModal" data-bs-data="DELAPPOINTMENT-Suppression du RDV-dateAtPromise"><i class="fa-duotone fa-light fa-trash-can-xmark"></i> Supprimer </a>
        </dd>
    {% endif %}
</dl>
<dl class="row g-1 align-items-center mb-1">
    <dt class="col-sm-3 mb-0">
        {% if transaction.dateAtSale %}
            <span class="text-success"><i class="fa-duotone fa-light fa-shield-check"></i></span>
        {% else %}
            <span class="text-warning"><i class="fa-duotone fa-light fa-circle-dashed"></i></span>
        {% endif %}
        Signature de l'acte :
    </dt>
    {% if transaction.dateAtSale %}
        <dd class="col-sm-3 mb-0"><span class="text-primary"> {{ transaction.dateAtSale|format_datetime('full', 'none', locale='fr') }} </span></dd>
        <dd class="col-sm-3 mb-0"><a href="{{ path('op_gestapp_transaction_editappointment', {'id':transaction.id, 'appointment': 'dateAtActe'}) }}" class="text-primary openModal" data-bs-data="EDITAPPOINTMENT-Modifier du RDV-dateAtActe"><i class="fa-light fa-arrows-rotate"></i> Actualiser la date</a></dd>
    {% else %}
        <dd class="col-sm-3 mb-0"><span class="text-primary"><em>Non défini</em></span></dd>
        <dd class="col-sm-3 mb-0"></dd>
    {% endif %}
    {% if access == 'admin' and transaction.dateAtSale is not null %}
        <dd class="col-sm-1 mb-0">
            <a href="{{ path('op_gestapp_transaction_delappointment', {'id':transaction.id, 'appointment': 'dateAtActe'}) }}" class="text-danger text-decoration-none openModal" data-bs-data="DELAPPOINTMENT-Suppresion du RDV-dateAtActe"><i class="fa-duotone fa-light fa-trash-can-xmark"></i> Supprimer </a>
        </dd>
    {% endif %}
</dl>
