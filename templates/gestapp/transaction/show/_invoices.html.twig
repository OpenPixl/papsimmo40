<p class="border-bottom mb-0"><b>Factures</b></p>
{% include 'gestapp/transaction/show/_document.html.twig' with {
    'documentValid' : transaction.isValidHonoraires,
    'typeDocument' : 'Honoraires',
    'slugDocument' : 'Ho',
    'nameDocument' : transaction.honorairesPdfFilename,
    'valid' : transaction.isValidHonoraires,
    'urlEdit': 'op_gestapp_transaction_editinvoices',
    'message' : 'message'
} %}
{% include 'gestapp/transaction/show/_document.html.twig' with {
    'documentValid' : transaction.isValidInvoicePdf,
    'typeDocument' : 'Facture',
    'slugDocument' : 'Fa',
    'nameDocument' : transaction.invoicePdfFilename,
    'valid' : transaction.isValidInvoicePdf,
    'urlEdit': 'op_gestapp_transaction_editinvoices',
    'message' : 'message'
} %}
{% if transaction.addCollTransacs|length > 0 %}
    {% for transac in transaction.addCollTransacs %}
        {% include 'gestapp/transaction/show/_document.html.twig' with {
            'documentValid' : transac.isValidInvoicePdf,
            'typeDocument' : 'Facture collaborateur',
            'slugDocument' : 'FColl',
            'nameDocument' : transac.InvoicePdfFilename,
            'valid' : transac.isValidInvoicePdf,
            'urlEdit': 'op_gestapp_transaction_editinvoices',
            'message' : 'message'
        } %}
    {% endfor %}
{% endif %}

