{% set stepRdvActive = [1,4] %}
{% set stepDocActive = [2,6,7] %}
{% set stepInvoiceActive = [5,9] %}
{% set stepCancelled = [13,14,15] %}
{% set isCancelled = '' %}
{% if transaction.isCancelled == 1 %}
    {% set isCancelled = 'disabled' %}
{% endif %}
<div class="col-6 justify-content-end" id="btnsTransaction">
    <a href="{{ path('op_gestapp_transaction_index') }}" class="btn btn-sm btn-outline-dark"><i class="fa-light fa-backward-step"></i> Retour</a>
    {# btn Acquéreurs #}
    <a href="{{ path('op_gestapp_transaction_addcustomer', {'id': transaction.id }) }}" class="btn btn-sm btn-outline-dark openModal {{ isCancelled }}" data-bs-data="ADDBUYERS-Ajouter un acheteur"><i class="fa-duotone fa-light fa-plus"></i> Acheteur</a>
    {# btn RDV #}
    <a href="{{ path('op_gestapp_transaction_addappointment', {'id': transaction.id }) }}" class="
        {% if transaction.step in stepRdvActive %}
            btn btn-sm btn-outline-dark openModal  {{ isCancelled }}
        {% else %}
            btn btn-sm btn-outline-secondary openModal disabled
        {% endif %}"
        data-bs-data="ADDAPPOINTMENT-Ajouter une date">
        <i class="fa-duotone fa-light fa-plus"></i> Date de RDV
    </a>
    {# btn Documents #}
    <a href="{{ path('op_gestapp_transaction_adddocuments', {'id': transaction.id }) }}" class="btn btn-sm {% if transaction.step in stepDocActive %}btn-outline-dark{% else %}btn-outline-secondary disabled{% endif %} openModal {{ isCancelled }}" data-bs-data="ADDDOCUMENTS-Ajouter un document"><i class="fa-duotone fa-light fa-plus"></i> Document</a>
    {# btn Factures #}
    <a
        {% if transaction.step in stepInvoiceActive %}
            {% if transaction.step == 11 and access == 'read' %}
                href="{{ path('op_gestapp_transaction_addcollaborator_addinvoice', {'refEmployed': app.user.id, 'idTransac': transaction.id}) }}"
            {% else %}
                href="{{ path('op_gestapp_transaction_addinvoices', {'id': transaction.id }) }}"
            {% endif %}
        {% endif %}
         class="btn btn-sm
        {% if transaction.step in stepInvoiceActive %}
            {% if transaction.step == 5 and access == 'edit' %}btn-outline-secondary disabled{% elseif transaction.step == 5 and access == 'admin' %}btn-outline-dark{% else %}btn-outline-dark{% endif %}
        {% else %}
            btn-outline-secondary disabled
        {% endif %}
         openModal {{ isCancelled }}" data-bs-data="ADDINVOICES-Ajouter une facture">
        <i class="fa-duotone fa-light fa-plus"></i> Factures
    </a>
    {{ transaction.step }}
</div>
<div class="col-6 d-flex align-items-center justify-content-end">
    {% if access == 'read' %}
        <p class="text-dark mb-0">Vous avez uniquement les droits de lecture sur ce document.</p>
    {% elseif access == 'edit' %}
        <p class="text-secondary mb-0">Vous avez les droits sur ce document en tant qu'éditeur.</p>
    {% else %}
        <p class="text-secondary mb-0">Vous avez les droits sur ce document en tant qu'administrateur.</p>
    {% endif %}
</div>