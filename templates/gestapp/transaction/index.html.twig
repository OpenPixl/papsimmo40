{% extends 'admin.html.twig' %}

{% block title %}Transaction index{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/gestapp/transaction/index/index.js') }}"></script>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item active"><a href="{{ path('op_admin_dashboard_index') }}"><i class="fa-duotone fa-house-blank"></i> Tableau de Bord</a></li>
        <li class="breadcrumb-item active">Transaction</li>
        <li class="breadcrumb-item active"><a href="{{ path('op_gestapp_property_index') }}">Listes des ventes</a></li>
    </ol>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-12">
            <h1 class="fs-4 border-bottom border-dark fw-normal">TRANSACTIONS - Ventes</h1>
        </div>
    </div>

    <div class="row">
        {% if 'ROLE_EMPLOYED' in app.user.roles %}
            <div class="col-12">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#ownliste" type="button" role="tab" aria-controls="home-tab-pane" aria-selected="true">Liste de mes ventes</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#coliste" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Ventes en coopération</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#listeclosed" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Liste des ventes cloturées</button>
                    </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="ownliste" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
                        {{ include('gestapp/transaction/include/_ownliste.html.twig') }}
                    </div>
                    <div class="tab-pane fade" id="coliste" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
                        {{ render(controller('App\\Controller\\Gestapp\\Transaction\\AddCollaboratorController::listByEmployed', {'idEmployed': app.user.id})) }}
                    </div>
                    <div class="tab-pane fade" id="listeclosed" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
                        {{ include('gestapp/transaction/include/_listeclosed.html.twig') }}
                    </div>
                </div>
            </div>
        {% elseif 'ROLE_ADMIN' in app.user.roles or 'ROLE_SUPER_ADMIN' in app.user.roles %}
            <div class="col-12">
                <ul class="nav nav-tabs" id="tabsListsTransacs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" id="maliste-tab" data-bs-toggle="tab" data-bs-target="#ownliste" type="button" role="tab" aria-controls="home-tab-pane" aria-selected="true">Liste de mes ventes</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="collabliste-tab" data-bs-toggle="tab" data-bs-target="#liste" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Liste des ventes des collaborateurs</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" id="coopliste-tab" data-bs-toggle="tab" data-bs-target="#coliste" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Ventes en coopération</a>
                    </li>
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="closedliste-tab" data-bs-toggle="tab" data-bs-target="#listeclosed" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Liste des ventes cloturées</a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="annulliste-tab" data-bs-toggle="tab" data-bs-target="#liste_cancelled" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Ventes annulées</a>
                        </li>
                    {% endif %}
                </ul>
                <div class="tab-content" id="myTabContent">
                    {{ include('gestapp/transaction/include/all_list_transactions.html.twig') }}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block modal %}
    {{ parent() }}
{% endblock %}
