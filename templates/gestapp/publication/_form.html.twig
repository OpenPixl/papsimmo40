{% set display = 'd-block' %}

{% if property.isNomandat == 1 %}
    {% set display = 'd-none' %}
{% endif %}
{{ form_start(form) }}
<div class="row {{ display }}">
    <div class="col-12">
        <table class="table table-sm mt-2">
            <thead>
                <tr class="align-bottom">
                    <td colspan="2">
                        <div class="form-check form-switch form-check-reverse">
                            <input class="form-check-input" type="checkbox" id="AllPublications">
                            <label class="form-check-label" for="flexSwitchCheckReverse">Valider toutes les publications</label>
                        </div>
                    </td>
                </tr>
            </thead>
            <tbody>
                <tr class="table-light">
                    <th colspan="2" class="text-uppercase">Publication sur l'application</th>
                </tr>
                <tr class="align-middle">
                    <td>{{ form_label(form.isWebpublish, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isWebpublish, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                {#
                <tr>
                    <td>Choissez le secteur de diffusion du bien</td>
                    <td>{{ form_widget(form.sector, {'attr': {'class': 'form-select form-select-sm'}}) }}</td>
                </tr>
                #}
                <tr class="table-light">
                    <th colspan="2" class="text-uppercase">Publications sur les plateformes.</th>
                </tr>
                <tr>
                    <td>{{ form_label(form.isPublishParven, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch  form-check-reverse">
                            {{ form_widget(form.isPublishParven, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                <tr class="d-none">
                    <td>{{ form_label(form.isPublishMeilleur, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishMeilleur, {'attr': {'class': 'form-check-input disabled', 'disabled':'disabled'}}) }}
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>{{ form_label(form.isPublishleboncoin, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishleboncoin, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                <tr class="d-none">
                    <td>{{ form_label(form.isPublishseloger, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishseloger, {'attr': {'class': 'form-check-input', 'disabled':'disabled'}}) }}
                        </div>
                    </td>
                </tr>
                {#
                <tr>
                    <td>{{ form_label(form.isPublishfigaro, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishfigaro, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                #}
                <tr>
                    <td>{{ form_label(form.isPublishgreenacres, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishgreenacres, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>{{ form_label(form.isPublishsuperimmo, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishsuperimmo, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                {#
                <tr>
                    <td>{{ form_label(form.isPublishalentoor, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishalentoor, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                #}
                <tr>
                    <td>{{ form_label(form.isPublishhtlouer, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishhtlouer, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>

                <tr>
                    <td>{{ form_label(form.isPublishBienici, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishBienici, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                {#
                <tr class="d-none">
                    <td>{{ form_label(form.isPublishClefsmoi, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishClefsmoi, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                #}
                <tr>
                    <td>{{ form_label(form.isPublishEtreProprio, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isPublishEtreProprio, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>{{ form_label(form.isSocialNetwork, '', {'label_attr': {'class':'form-check-label'}}) }}</td>
                    <td>
                        <div class="form-check form-switch form-check-reverse">
                            {{ form_widget(form.isSocialNetwork, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
{% if display == 'd-none' %}
    <div class="row py-3">
        <div class="col-12">
            <p class="alert alert-warning">
                Votre bien ne possède pas de numéro de mandat. Dans l'état actuel, vous ne pouvez pas publier ce bien sur notre plateforme, ni chez nos diffuseurs.
            </p>
        </div>
    </div>
{% endif %}
{{ form_end(form) }}
