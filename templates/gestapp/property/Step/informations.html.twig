<section class="property-edit">
    {{ form_start(form) }}
    <div class="row g-1">
        <div class="col-sm-12">
            <div class="card ext-dark bg-light mb-1">
                <div class="card-body p-2">
                    {% if property.refMandat is empty %}
                        <div class="row" id="FormMandat">
                            <div class="col">
                                <p class="text-danger">
                                    Ce bien ne possède pas de numéro de mandat.
                                    Vous ne pourrez pas continuer sa création tant que ce champ est vide.
                                </p>
                            </div>
                        </div>
                    {% endif %}
                    <div class="row align-items-center">
                        <div class="col-1">
                            <p class="fw-bold mb-0">LE MANDAT</p>
                        </div>
                        <div class="col-1">
                            {% if property.dupMandat is not empty %}
                                <p class="mb-0"><span class="text-secondary">Numéro :</span> {{ property.refMandat }}{{ property.dupMandat }}</p>
                            {% else %}
                                {# controle si le mandat porte le numéro 0 #}
                                {% if property.refMandat == 0 %}
                                    <p class="mb-0"><a id="AddMandat" href="{{ path('op_gestapp_property_addmandat', {'id':property.id}) }}" class="text-info openModal" data-bs-data="ADDMANDAT-Ajouter un numéro de mandat au bien-{{ property.id }}"><i class="fa-sharp fa-solid fa-circle-plus"></i> Ajouter le mandat</a></p>
                                {% else %}
                                    <p class="mb-0"><span class="text-secondary">Numéro :</span> {{ property.refMandat }}</p>
                                {% endif %}
                            {% endif %}
                        </div>
                        <div class="col-2">
                            <p class="mb-0"><span class="text-secondary">créer le :</span> {{ property.mandatAt|format_datetime('medium','none', locale='fr') }}</p>
                        </div>
                        <div class="col-2">
                            <p class="mb-0"><span class="text-secondary">Ref</span> : {{ property.ref }}</p>
                        </div>
                        <div class="col-6">
                            {% for label, value, choice in field_choices(form.typeMandat) %}
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="{{ field_name(form.typeMandat) }}" id="inlineRadio1" value="{{ value }}" {% if value is same as property.typeMandat %}checked="checked"{% endif %}>
                                    <label class="form-check-label" for="inlineRadio1">{{ label }}</label>
                                </div>
                            {% endfor %}
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-9">
            <div class="card mb-1">
                <div class="card-body p-2">
                    <p class="border-bottom"><b>INFORMATIONS DU BIENS</b></p>
                    <div class="row mt-1">
                        <div class="col-8">
                            <div class="row align-items-center mb-1">
                                <div class="col-2 mb-1">
                                    <input id="property_id" type="hidden" value="{{ property.id }}">
                                    {{ form_label(form.name, '', {'label_attr': {'class':'form-label mb-0 text-secondary'}}) }}
                                </div>
                                <div class="col-10 mb-1">
                                    {{ form_widget(form.name, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                    <p id="charCount" class="small text-secondary">100 caractères restants</p>
                                </div>
                            </div>
                            <div class="row align-items-center ">
                                <div class="col-2">
                                    {{ form_label(form.adress, '', {'label_attr': {'class':'form-label mb-0 text-secondary'}}) }}
                                </div>
                                <div class="col-5">
                                    {{ form_widget(form.adress, {'attr': {'class': 'form-control form-control-sm mb-1', 'placeholder': 'Adresse'}}) }}
                                    {{ form_widget(form.complement, {'attr': {'class': 'form-control form-control-sm mb-1', 'placeholder': 'complement d\'adresse'}}) }}
                                    <div class="row g-1">
                                        <div class="col-3">
                                            {{ form_widget(form.zipcode, {'attr': {'class': 'form-control form-control-sm', 'placeholder': 'CP'}}) }}
                                        </div>
                                        <div class="col-9">
                                            {{ form_widget(form.city, {'attr': {'class': 'form-control form-control-sm', 'placeholder':'Commune'}}) }}
                                            <select id="selectcity" class="form-select form-select-sm">
                                                <option>{{ form.zipcode.vars.data }} - {{ form.city.vars.data }}</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="row align-items-center mb-1">
                                <div class="col-6 mb-1">
                                    {{ form_label(form.piece, '', {'label_attr': {'class':'form-label mb-0 text-secondary'}}) }}
                                </div>
                                <div class="col-6 mb-1">
                                    {{ form_widget(form.piece, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                </div>
                            </div>
                            <div class="row align-items-center mb-1">
                                <div class="col-6 mb-1">
                                    {{ form_label(form.room, '', {'label_attr': {'class':'form-label mb-0 text-secondary'}}) }}
                                </div>
                                <div class="col-6 mb-1">
                                    {{ form_widget(form.room, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                </div>
                            </div>
                            <div class="row align-items-center mb-1">
                                <div class="col-6 mb-1">
                                    {{ form_label(form.constructionAt, '', {'label_attr': {'class':'form-label mb-0 text-secondary'}}) }}
                                </div>
                                <div class="col-6 mb-1">
                                    {{ form_widget(form.constructionAt, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% if property.typeMandat == 'avec_exclusivité_vente_interactive' %}
                <div id="block_ExcluVI" class="card">
                    <div class="card-body p-2">
                        <p><b>VENTE INTERACTIVE</b></p>
                        <div class="row">
                            {{ form_label(form.addLinkAuction) }}
                            <div class="col-sm-12">
                                {{ form_widget(form.addLinkAuction, {'attr': {'class': 'form-control form-control-sm w-100', 'placeholder':'https://example.com'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="card d-none">
                    <div class="card-body">
                        <p><b>VENTE INTERACTIVE</b></p>
                        <div class="row">
                            {{ form_label(form.addLinkAuction) }}
                            <div class="col-sm-12">
                                {{ form_widget(form.addLinkAuction, {'attr': {'class': 'form-control form-control-sm w-100', 'placeholder':'https://example.com'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
        <div class="col-sm-3">
            <div class="row mb-1">
                <div class="col-12">
                    <div class="card text-dark bg-light mb-1">
                        <div class="card-body">
                            <p><b>DESTINATION DU BIEN</b></p>
                            <p class="mb-2">Compléter ces informations pour garantir la publication du bien sur les plateformes de diffusion.</p>
                            <table class="table table-sm table-borderless">

                                <tr id="RowFamily" class="align-middle">
                                    <td class="col-5">{{ form_label(form.family, '', {'label_attr': {'class':'m-0 form-label'}}) }}</td>
                                    <td class="col-6">{{ form_widget(form.family, {'attr': {'class': 'form-select form-select-sm'}}) }}</td>
                                    <td class="col-1"></td>
                                </tr>
                                <tr id="rowRubric" class="align-middle">
                                    <td class="col-5">{{ form_label(form.rubric, '', {'label_attr': {'class':'m-0 form-label'}}) }}</td>
                                    <td class="col-6">{{ form_widget(form.rubric, {'attr': {'class': 'form-select form-select-sm'}}) }}</td>
                                    <td class="col-1"></td>
                                </tr>
                                <tr id="rowRubricss" class="align-middle">
                                    <td>{{ form_label(form.rubricss, '',{'label_attr': {'class':'m-0 form-label'}}) }}</td>
                                    <td>{{ form_widget(form.rubricss, {'attr': {'class': 'form-select form-select-sm'}}) }}</td>
                                    <td></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{ form_rest(form) }}
    {{ form_end(form) }}
</section>