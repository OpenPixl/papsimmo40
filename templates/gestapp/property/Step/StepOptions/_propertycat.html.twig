{{ form_label(form.denomination, '', {'label_attr': {'class':'col-sm-2  form-label'}}) }}
<div class="col-4">
    {{ form_widget(form.denomination, {'attr': {'class': 'oneChoice'}}) }}
</div>
{% if is_granted('ROLE_SUPER_ADMIN') %}
    <div class="col-1">
        <a id="addHouseCat" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'une catégorie-0"><i class="fa-duotone fa-circle-plus"></i></a>
    </div>
{% else %}
    <div class="col-1">
        <a id="addHouseCat" class="btn btn-sm btn-secondary openModal" data-bs-data="ADDBANNER-Ajout d'une bannière-0" disabled><i class="fa-duotone fa-circle-plus text-light"></i></a>
    </div>
{% endif %}