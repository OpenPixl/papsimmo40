<div class="card text-dark bg-light">
    <div class="card-body p-2">
        <p>
            <b>Attention :</b>
        </p>
        <p class="alert alert-info p-2 mb-1">
            Ne sont accepté que les photos au format JPEG, JPG et dont la taille n'excède pas 20Mo.
        </p>
        {{ form_start(form, {'attr': {'id': 'addPhoto'}}) }}

        {{ form_widget(form.images, {'attr': {'class': 'form-control-file form-control-sm'}}) }}
        <div class="mt-1">
            <button type="submit" id="btnAddPhoto" class="btn btn-sm btn-outline-primary">{{ button_label|default('Ajouter') }}</button>
        </div>
        {{ form_end(form) }}
    </div>
</div>

