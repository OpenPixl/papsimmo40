{{ form_start(form) }}
<div class="row">
    <div class="col-12">
        <p class="alert alert-info p-2 mb-1">
            Ne sont accepté que les photos au format JPEG, JPG et dont la taille n'excède pas 20Mo.
        </p>
    </div>
    <div class="col-12">
    {{ form_widget(form.images, {'attr': {'class': 'form-control-file form-control-sm'}}) }}
    </div>
</div>
<div class="row mt-1">
    <div class="col-12">
        <button id="btnPhotos" type="submit" class="btn btn-sm btn-outline-primary w-100">{{ button_label|default('Ajouter le(s) photo(s)') }}</button>
    </div>
</div>
{{ form_end(form) }}


