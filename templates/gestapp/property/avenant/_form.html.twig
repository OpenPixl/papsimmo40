{{ form_start(form) }}
<div class="row mb-1">
    <div class="col-5">
        <span class="align-middle"><b>{{ form_label(form.dateAvenant, '', {'label_attr': {'class':'form-label'}}) }}</b></span>
    </div>
    <div class="col-4">
        {{ form_widget(form.dateAvenant, {'attr': {'class': 'form-control form-control-sm flatpickr'}}) }}
    </div>
</div>
<div class="row mb-1">
    <div class="col-5">
        <span class="align-middle">{{ form_label(form.price, '', {'label_attr': {'class':'form-label'}}) }}</span>
    </div>
    <div class="col-7">
        {{ form_widget(form.price, {'attr': {'class': 'form-control form-control-sm'}}) }}
    </div>
</div>
<div class="row mb-1">
    <div class="col-5">
        {{ form_label(form.honoraires, '', {'label_attr': {'class':'form-label'}}) }}
    </div>
    <div class="col-7">
        {{ form_widget(form.honoraires, {'attr': {'class': 'form-control form-control-sm'}}) }}
    </div>
</div>
<div class="row mb-1">
    <div class="col-5">
        {{ form_label(form.priceFai, '', {'label_attr': {'class':'form-label'}}) }}
    </div>
    <div class="col-7">
        {{ form_widget(form.priceFai, {'attr': {'class': 'form-control form-control-sm'}}) }}
    </div>
</div>
<h6 class="fs-6 border-bottom mt-3">DOCUMENT A DEPOSER</h6>
<div class="row">
    <div class="col-12">
        <p class="alert alert-info p-2">
            {{ form_label(form.avenantName) }}
        </p>
    </div>
    <div class="col-12">
        {{ form_widget(form.avenantName, {'attr': {'class':'form-control form-control-sm'}}) }}
    </div>
</div>
{{ form_end(form) }}
