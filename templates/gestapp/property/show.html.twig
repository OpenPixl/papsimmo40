{% extends 'admin.html.twig' %}

{% block title %}SoftPAPs - Gestion d'un bien{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/gestapp/property/show.js') }}"></script>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item active"><a href="{{ path('op_admin_dashboard_index') }}"><i class="fa-duotone fa-house-blank"></i> Tableau de Bord</a></li>
        <li class="breadcrumb-item active">Transaction</li>
        <li class="breadcrumb-item active"><a href="{{ path('op_gestapp_property_index') }}">Biens immobilier</a></li>
        <li class="breadcrumb-item active">Fiche {{ property.ref }}</li>
    </ol>
{% endblock %}

{% block contentTitle %}
    {% if property.isIncreating == 0 %}
        <h1 class="fs-3">Edition du bien : {{ property.name }}</h1>
    {% else %}
        <h1 class="fs-3">Création un nouveau bien</h1>
    {% endif %}

    {# read and display several types of flash messages #}
    {% for label, messages in app.flashes(['success', 'warning']) %}
        {% for message in messages %}
            <div class="flash-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% if property.isIncreating > 0 %}
        {# Etiquettes du panel #}
        <ul id="admin-tab" class="nav nav-tabs">
            <li class="nav-item">
                <a id="navInformations" href="{{ path('op_gestapp_property_informations', {'id':property.id}) }}" class="nav-link active" aria-current="page" data-bs-toggle="tab" data-bs-target="#Informations" type="button" role="tab" aria-controls="Informations" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-memo-circle-info"></i> Informations</h5></a>
            </li>
            <li class="nav-item notActive">
                <a id="navAnnonce" href="{{ path('op_gestapp_property_annonce', {'id':property.id}) }}" class="nav-link disabled" aria-current="page" data-bs-toggle="tab" data-bs-target="#Annonce" type="button" role="tab" aria-controls="Annonce" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-solid fa-file-lines"></i> Annonce</h5></a>
            </li>
            <li class="nav-item notActive">
                <a id="navCustomers notActive" href="{{ path('op_gestapp_customer_listbyproperty', {'id':property.id}) }}" class="nav-link disabled" aria-current="page" data-bs-toggle="tab" data-bs-target="#Customers" type="button" role="tab" aria-controls="Vendeurs" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-user-tie-hair"></i> Vendeurs</h5></a>
            </li>
            <li class="nav-item notActive">
                <a id="navEstimate" href="{{ path('op_gestapp_property_chiffres', {'id':property.id}) }}" class="nav-link disabled" aria-current="page" data-bs-toggle="tab" data-bs-target="#Estimate" type="button" role="tab" aria-controls="Estimations" aria-selected="true"><h5 class="mb-0">Chiffres</h5></a>
            </li>
            <li class="nav-item notActive">
                <a id="navOptions" href="{{ path('op_gestapp_complement_edit', {'id':complement}) }}" class="nav-link disabled" aria-current="page" data-bs-toggle="tab" data-bs-target="#Options" type="button" role="tab" aria-controls="Complements" aria-selected="true"><h5 class="mb-0">Complements</h5></a>
            </li>
            <li class="nav-item notActive">
                <a id="navGallery" href="{{ path('op_gestapp_photo_byproperty', {'idproperty':property.id}) }}" class="nav-link disabled" aria-current="page" data-bs-toggle="tab" data-bs-target="#Gallery" type="button" role="tab" aria-controls="Galerie" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-gallery-thumbnails"></i> Galerie</h5></a>
            </li>
            <li class="nav-item notActive">
                <a id="navPublication" href="{{ path('op_admin_contact_showbyproperty', {'id': publication }) }}" class="nav-link disabled" aria-current="page" data-bs-toggle="tab" data-bs-target="#Publication" type="button" role="tab" aria-controls="Publication" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-browser"></i> Publication</h5></a>
            </li>
        </ul>
    {% else %}
        {# Etiquettes du panel si le bien est entièrement enregistré #}
        <ul id="admin-tab" class="nav nav-tabs">
            <li class="nav-item">
                <a id="navInformations2" href="{{ path('op_gestapp_property_informations', {'id':property.id}) }}" class="nav-link active" aria-current="page" data-bs-toggle="tab" data-bs-target="#Informations" type="button" role="tab" aria-controls="Informations" aria-selected="true"><h5 class="mb-0 fs-5"><i class="fa-duotone fa-memo-circle-info"></i> Informations</h5></a>
            </li>
            <li class="nav-item">
                <a id="navAnnonce2" href="{{ path('op_gestapp_property_annonce', {'id':property.id}) }}" class="nav-link" aria-current="page" data-bs-toggle="tab" data-bs-target="#Annonce" type="button" role="tab" aria-controls="Annonce" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-solid fa-file-lines"></i> Annonce</h5></a>
            </li>
            <li class="nav-item">
                <a id="navCustomers2" href="{{ path('op_gestapp_customer_listbyproperty', {'id':property.id}) }}" class="nav-link" aria-current="page" data-bs-toggle="tab" data-bs-target="#Customers" type="button" role="tab" aria-controls="Vendeurs" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-user-tie-hair"></i> Vendeurs</h5></a>
            </li>
            <li class="nav-item">
                <a id="navEstimate2" href="{{ path('op_gestapp_property_chiffres', {'id':property.id}) }}" class="nav-link" aria-current="page" data-bs-toggle="tab" data-bs-target="#Estimate" type="button" role="tab" aria-controls="Estimations" aria-selected="true"><h5 class="mb-0">Chiffres</h5></a>
            </li>
            <li class="nav-item">
                <a id="navOptions2" href="{{ path('op_gestapp_complement_edit', {'id':complement}) }}" class="nav-link" aria-current="page" data-bs-toggle="tab" data-bs-target="#Options" type="button" role="tab" aria-controls="Complements" aria-selected="true"><h5 class="mb-0">Complements</h5></a>
            </li>
            <li class="nav-item">
                <a id="navGallery2" href="{{ path('op_gestapp_photo_byproperty', {'idproperty':property.id}) }}" class="nav-link" aria-current="page" data-bs-toggle="tab" data-bs-target="#Gallery" type="button" role="tab" aria-controls="Galerie" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-gallery-thumbnails"></i> Galerie</h5></a>
            </li>
            <li class="nav-item">
                <a id="navPublication2" href="{{ path('op_admin_contact_showbyproperty', {'id': publication }) }}" class="nav-link" aria-current="page" data-bs-toggle="tab" data-bs-target="#Publication" type="button" role="tab" aria-controls="Publication" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-browser"></i> Publication</h5></a>
            </li>
            <li class="nav-item">
                <a id="navDocuments2" class="nav-link" aria-current="page" data-bs-toggle="tab" data-bs-target="#Documents" type="button" role="tab" aria-controls="Documents" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-solid fa-file-pdf"></i> Documents</h5></a>
            </li>
            <li class="nav-item">
                <a id="navMap2" class="nav-link" aria-current="page" data-bs-toggle="tab" data-bs-target="#Map" type="button" role="tab" aria-controls="Map" aria-selected="true"><h5 class="mb-0"><i class="fa-duotone fa-solid fa-file-pdf"></i> Carte</h5></a>
            </li>
        </ul>
    {% endif %}
{% endblock %}

{% block content %}
    {# Div's du panel #}
    <div class="tab-content">
        {# STEP 1 : INFORMATIONS #}
        <div class="tab-pane active" id="Informations" role="tabpanel" aria-labelledby="informations-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION INFORMATIONS SUR LE BIEN</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {# STEP 1 : ANNONCE #}
        <div class="tab-pane" id="Annonce" role="tabpanel" aria-labelledby="annonce-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION ANNONCE</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {# STEP 2 : VENDEURS #}
        <div class="tab-pane" id="Customers" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION VENDEURS</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {# STEP 3 : ESTIMATIONS #}
        <div class="tab-pane" id="Estimate" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION CHIFFRES</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {# STEP 4 : COMPLEMENTS #}
        <div class="tab-pane" id="Options" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION COMPLEMENT</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {# STEP 5 : IMAGES #}
        <div class="tab-pane" id="Gallery" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION PHOTO</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {# STEP 6 : PUBLICATIONS #}
        <div class="tab-pane" id="Publication" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION PUBLICATION</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="Documents" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION DOCUMENTS</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="Map" role="tabpanel" aria-labelledby="profile-tab">
            <div class="row mt-2">
                <div class="col-12">
                    <h2 class="fs-5 border-bottom">SECTION CARTE</h2>
                    <div id="content-form">
                        <div class="text-center p-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block contentFooter %}
    <div class="row mt-2">
        <div class="col-12">
            {% if property.isIncreating == 1 %}
                <a href="{{ path('op_gestapp_property_index') }}" class="btn btn-sm btn-outline-dark"> <i class="fa-solid fa-backward-step"></i> Retour sur la liste des biens</a>
                <button id="btnAddProperty" type="button" class="btn btn-sm btn-outline-primary">Valider et passer à l'étape suivante</button>
            {% else %}
                <a href="{{ path('op_gestapp_property_index') }}" class="btn btn-sm btn-outline-dark"> <i class="fa-solid fa-backward-step"></i> Retour sur la liste des biens</a>
                <button id="btnUpdateProperty" type="button" class="btn btn-sm btn-outline-primary">Valider les modifications</button>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block modal %}
    {{ parent() }}
{% endblock %}
