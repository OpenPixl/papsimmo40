{% set diffuseurs = {
    pv: {'count': 0, 'actif': 1, 'prop': 'isPublishParven', label: 'PV', name: 'Paru Vendu', href: '#'},
    sl: {'count': 0, 'actif': 0, 'prop': 'isPublishseloger', label: 'SL', name: 'Se loger', href: '#' },
    lb: {'count': 0, 'actif': 1, 'prop': 'isPublishleboncoin', label: 'LB', name: 'LeBonCoin', href: asset('doc/report/leboncoin/Annonces.xlsx')},
    fig: {'count': 0, 'actif': 1, 'prop': 'isPublishfigaro', label: 'FIG', name: 'Figaro', href: asset('doc/report/figaro/Annonces.xlsx')},
    ma: {'count': 0, 'actif': 0, 'prop': 'isPublishMeilleur', label: 'MA', name: 'Meilleur Agent', href: '#'},
    ga: {'count': 0, 'actif': 1, 'prop': 'isPublishgreenacres', label: 'MA', name: 'Green ACRES', href: asset('doc/report/Green/892318a.xlsx')},
    si: {'count': 0, 'actif': 1, 'prop': 'isPublishsuperimmo', label: 'SI', name: 'Super Immo', href: asset('doc/report/Superimmo/paps_superimmo.xlsx')},
    al: {'count': 0, 'actif': 0, 'prop': 'isPublishalentoor', label: 'Alentour', name: 'Alentoor', href: asset('doc/report/Alentour/paps_alentour.xlsx')},
    ht: {'count': 0, 'actif': 1, 'prop': 'isPublishhtlouer', label: 'HT', name: 'HtLouer', href: asset('doc/report/Htlouer/g46426.xlsx')},
    bi: {'count': 0, 'actif': 1, 'prop': 'isPublisBienici', label: 'BI', name: 'BienICI', href: asset('doc/report/ubiflow/ubiflow.xlsx')},
    cm: {'count': 0, 'actif': 0, 'prop': 'isPublishClefsmoi', label: 'CM', name: 'Chez Moi', href: asset('doc/report/lcdcm/paps_lcdcm.xlsx')},
} %}

{% for property in listproperties %}
    {% for key, diffuseur in diffuseurs %}
        {% if attribute(property, diffuseur.prop) == 1 %}
            {% set diffuseurs = diffuseurs|merge({ (key) : diffuseur|merge({'count': diffuseur.count + 1}) }) %}
        {% endif %}
    {% endfor %}
{% endfor %}

{% if is_granted('ROLE_ADMIN') %}
<div class="mt-2">
    <p>
        <b>Support des diffusions :</b>
    </p>
    <p style="font-size: 0.8rem;">
        |
        {% for d in diffuseurs %}
            {% if d.actif == 1 %}
                <span class="badge bg-light text-dark">{{ d.label }} : {{ d.count }}</span> <a href="{{ d.href }}" download>{{ d.name }}</a> |
            {% endif%}
        {% endfor %}
    </p>
</div>
{% endif %}
<table class="table">
    <thead>
        <tr>
            {% if is_granted('ROLE_ADMIN') %}
                <th><input type="checkbox" id="CheckAllProperties" name="CheckAllProperties"></th>
                <th></th>
                <th>Collaborateur</th>
            {% else %}
            <th></th>
            {% endif %}
            <th>Mandat</th>
            <th>Prix</th>
            <th>Titre annonce</th>
            <th>En ligne</th>
            <th>Publication</th>
            <th>actions</th>
        </tr>
    </thead>
    <tbody>
    {% set user = app.user.id %}
    {% for property in listproperties %}
        <tr class="align-middle">
            {% if is_granted('ROLE_ADMIN') %}
                <td>
                    <input type="checkbox" id="CheckProperty" name="CheckProperty" value="{{ property.id }}">
                </td>
                <td>
                    {{ render(controller('App\\Controller\\Gestapp\\PhotoController::includeinlistproperty', {'idproperty': property.id})) }}
                </td>
                <td>
                    {% if property.avatarName is not null %}
                        <img class="rounded-circle" src="{{ asset('images/avatar/' ~ property.avatarName) }}" alt="{{ property.avatarName }}" style="height:50px;width:50px">
                    {% else %}
                        <img class="rounded-circle" src="{{ asset('images/jpeg/user.jpg') }}" alt="" style="height:50px;width:50px">
                    {% endif %}
                    {{ property.firstName }} {{ property.lastName }}
                </td>

            {% else %}
                <td>
                    <input type="checkbox" id="CheckProperty" name="CheckProperty" value="{{ property.id }}">
                </td>
                <td>
                    {{ render(controller('App\\Controller\\Gestapp\\PhotoController::includeinlistproperty', {'idproperty': property.id})) }}
                </td>
            {% endif %}
            {# boucle si la propriété est indexé avec un mandat #}
            {% if property.isNomandat == 0 %}
                {% if property.dupMandat is not empty %}
                    <td><b>{{ property.refMandat }}{{ property.dupMandat }}</b><br>{{ property.ref }}</td>
                {% else %}
                    <td><b>{{ property.refMandat }}{{ property.dupMandat }}</b><br>{{ property.ref }}</td>
                {% endif %}
            {% else %}
                <td><span class="badge bg-secondary">Sans mandat</span></td>
            {% endif %}
            <td>{{ property.priceFai }}€</td>
            <td>{{ property.name|u.truncate(60, ' ...') }}<br>{{ property.zipcode }} {{ property.city }}</td>
            <td>
                {% if property.isWebpublish == 1 %}<i class="fa-thin fa-globe text-success"></i>{% else %}<i class="fa-thin fa-globe text-danger"></i>{% endif %}
            </td>
            <td>

                {# On initialise le tableau des diffuseurs actifs pour cette propriété #}
                {% set diffuseursWithProperty = {} %}

                {% for key, diffuseur in diffuseurs %}
                    {% if attribute(property, diffuseur.prop) == 1 %}
                        {% set diffuseursWithProperty = diffuseursWithProperty|merge({ (key) : diffuseur }) %}
                    {% endif %}
                {% endfor %}

                {# Affichage des diffuseurs actifs pour cette propriété #}
                {% if diffuseursWithProperty is not empty %}

                        {% for key, diffuseur in diffuseursWithProperty %}
                            {% if diffuseur.actif == 1 %}
                                <span class="badge bg-success text-light">{{ diffuseur.label }}</span>
                            {% endif %}
                        {% endfor %}

                {% else %}
                {% endif %}

            </td>
            <td>
                {% include('gestapp/property/include/_btnchoice.html.twig') %}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="30">Aucun collaborateur ou vous même avez enregistré de biens immobiliers pour l'instant.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>