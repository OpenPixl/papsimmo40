<!doctype html>
<html lang="fr">
{{ include('admin/mail/include/head.html.twig') }}
<div class="body">
    <div class="container">
        <div class="header text-center">
            <a href="{{ url('op_webapp_public_homepage') }}">
                <img src="{{ email.image('@images/png/LogoPAPSimmo.png') }}" class="logo" alt="Logo" style="height: 100px; width: auto">
            </a>
            {% set step_date = [] %}
            {% set step_document = [] %}
            {% set step_attente = [] %}

            {% if transaction.step in step_date %}
                <h1>[PAPs Immo - TRANSACTION ] : Un RDV vient d'être ajouté.</h1>
            {% elseif transaction.step in step_document %}
                <h1>[PAPs Immo - TRANSACTION ] : Un document attends votre approbation.</h1>
            {% elseif transaction.step in step_attente %}
                <h1>[PAPs Immo - TRANSACTION ] : Un document attends votre approbation.</h1>
            {% else %}
                <h1>[PAPs Immo - TRANSACTION ] : Un document attends votre approbation.</h1>
            {% endif %}
        </div>
        <div class="content">
            <h3>Transaction n°: {{ transaction.name }}</h3>
            <hr>
            <h4>Bonjour,</h4>
                {% if transaction.promisePdfFilename is not null and transaction.dateAtSale is null and transaction.actePdfFilename is null and transaction.tracfinPdfFilename is null %}
                    <p>
                        Dans le cadre de la transaction immobilière {{ transaction.name }}, l'un de vos collaborateurs à déposer
                        un compromis de vente : {{ transaction.promisePdfFilename }}.<br>
                        En cliquant sur le lien suivant vous pourrez-le controler.
                    </p>
                {% elseif transaction.promisePdfFilename is not null and transaction.dateAtSale is not null and transaction.actePdfFilename is null and transaction.tracfinPdfFilename is null %}
                    <p>
                        Dans le cadre de la transaction immobilière {{ transaction.name }}, l'acte de vente a été signé le {{ transaction.dateAtSale|format_datetime('medium', 'none', locale='fr') }}<br>
                        Une facture d'honoraire doit être déposée dans le dossier.
                    </p>
                {% elseif transaction.promisePdfFilename is not null and transaction.dateAtSale is not null and transaction.actePdfFilename is not null and transaction.tracfinPdfFilename is null %}
                    <p>
                        Dans le cadre de la transaction immobilière {{ transaction.name }}, l'un de vos collaborateurs à déposer
                        une attestation de vente : {{ transaction.actePdfFilename }}.<br>
                        En cliquant sur le lien suivant vous pourrez-le controler.
                    </p>
                {% elseif transaction.promisePdfFilename is not null and transaction.dateAtSale is not null and transaction.actePdfFilename is not null and transaction.tracfinPdfFilename is not null %}
                    <p>
                        Dans le cadre de la transaction immobilière {{ transaction.name }}, l'un de vos collaborateurs à déposer
                    un tracfin : {{ transaction.tracfinPdfFilename }}.<br>
                        En cliquant sur le lien suivant vous pourrez-le controler.
                    </p>
                {% endif%}
            <p>
                <a class="btn" href="https://{{ url }}{{ path("op_gestapp_transaction_show2", {'id': transaction.id}) }}">Accès à la fiche de vente</a>
            </p>

        </div>
    </div>
</div>

