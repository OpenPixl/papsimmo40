<!doctype html>
<html lang="fr">
{{ include('admin/mail/include/head.html.twig') }}
<div class="body" style="margin-bottom: 20px;margin-top: 20px;">
    <div class="container">
        <div class="header text-center">
            <a href="{{ url('op_webapp_public_homepage') }}">
                <img src="{{ email.image('@images/png/LogoPAPSimmo.png') }}" class="logo" alt="Logo" style="height: 100px; width: auto">
            </a>
            {% set step_ouverture = [0] %}
            {% set step_date = [2,6] %}
            {% set step_document = [3,7] %}
            {% set step_attente = [4,9,11] %}

            {% if transaction.step == 0 %}
                <h1>[PAPs Immo - TRANSACTION ] : Ouverture du Dossier.</h1>
            {% endif %}
            {% if transaction.step == 1 %}
                <h1>[PAPs Immo - TRANSACTION ] : Nouvel acheteur au dossier.</h1>
            {% endif %}
            {% if transaction.step in step_date %}
                <h1>[PAPs Immo - TRANSACTION ] : Un RDV vient d'être ajouté.</h1>
            {% endif %}
            {% if transaction.step in step_document %}
                <h1>[PAPs Immo - TRANSACTION ] : Un document attends votre approbation.</h1>
            {% endif %}
        </div>
        <div class="content">
            <h3>Dossier n°: {{ transaction.name }}</h3>
            <hr>
            <h4>Bonjour,</h4>
                {% if transaction.step == 0 %}
                    <p>
                        L'un de vos collaborateur à ouvert une nouvelle transaction immobilière : {{ transaction.name }}.<br>
                        Cette démarche ne requiert aucune intervention de votre part.
                    </p>
                {% endif %}
                {% if transaction.step == 1 %}
                    <p>
                        L'un de vos collaborateur : {% if transaction.refEmployed.civility == 1 %}M. {% else %}Mme {% endif %}{{ transaction.refEmployed.firstName }} {{ transaction.refEmployed.lastName }}, a ajouté un acheteur au dossier.
                        <br>
                        Cette démarche ne requiert aucune intervention de votre part mais est incrite dans l'historique du dossier.
                    </p>
                {% endif %}
                {% if transaction.step in step_date %}
                    <p>
                        L'un de vos collaborateur : {% if transaction.refEmployed.civility == 1 %}M. {% else %}Mme {% endif %}{{ transaction.refEmployed.firstName }} {{ transaction.refEmployed.lastName }}, a ajouté une date de signature de document au dossier..
                        <br>
                        Cette démarche ne requiert aucune intervention de votre part.
                    </p>
                {% endif %}
                {% if transaction.step in step_document %}
                    <p>
                        L'un de vos collaborateur : {% if transaction.refEmployed.civility == 1 %}M. {% else %}Mme {% endif %}{{ transaction.refEmployed.firstName }} {{ transaction.refEmployed.lastName }},a ajouté un document au dossier.
                        <br>
                        Nous vous invitons à verifier le document.
                    </p>
                {% endif%}
                {% if transaction.step in step_attente %}
                    <p>
                        Dans le cadre de la transaction immobilière {{ transaction.name }}, Un document a été déposé sur la plateforme.
                        <br>
                        En cliquant sur le lien suivant vous pourrez-le controler.
                    </p>
                {% endif%}
            <p>L'équipe PAPs immo.</p>
            <p>
                <a class="btn " href="#">Accès à la fiche de vente</a>
            </p>

        </div>
    </div>
</div>

