{% extends 'base.html.twig' %}

{% block title %}{{ employed.firstName }} {{ employed.lastName }} - Agent Mandataire | PAPs immo{% endblock %}

{% block content %}
    <section id="prez_collaborateur" class="container">
        <div class="row mt-5 mb-5">
            <div class="col-4">
                <div class="row justify-content-center">
                    <div class="col-8">
                        <p class="text-center">
                            {% if employed.avatarName is not null %}
                                <img class="img-fluid" src="{{ asset('images/avatar/' ~ employed.avatarName) }}" alt="{{ employed.firstName }} {{ employed.lastName }}">
                            {% else %}
                                <img class="img-fluid" src="{{ asset('images/jpeg/LogoPAPSimmo-Blanc.jpg')}}" alt="pas d'avatar">
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-8">
                <h1 class="text-start">
                    {% if is_granted('ROLE_ADMIN') %}
                        Agent <strong>{{ employed.firstName }} {{ employed.lastName }}</strong><br>
                    {% else %}
                        {% if employed.civility == 1%}M.{% else %}Mme{% endif%} {{ employed.firstName }} {{ employed.lastName }}
                    {% endif %}
                </h1>
                {% if employed.sector is null %}
                {% else %}
                    <h2 class="h3 text-start">Opérant sur le secteur : {{ employed.sector }}</h2>
                {% endif %}
                {% if employed.employedPrez is null %}
                    <p class="text-start">
                        <strong>VENDRE</strong> ou <strong>ACHETER</strong> un bien immobilier est un acte important.
                        L'accompagnement d'un professionnel est nécessaire pour réussir votre projet sereinement et en toute sécurité.
                        <br>
                        <strong>PAPs immo</strong> est à votre service pour toute transaction, achat, vente (maison, appartement, immeuble, terrain constructible, terrain forestier, terrain viticole, tous types de commerces). 
                        Une disponibilité, un suivi, une exigence permanente valorisent la qualité de la relation de confiance que nous établirons pour finaliser vos projets.
                    </p>
                {% else %}
                <p class="text-start mb-3">
                    {{ employed.employedPrez }}
                </p>
                {% endif %}
                <div class="row align-items-center">
                    <div class="col-8">
                        <p class="text-start mb-0">
                            {% set emailUser = employed.email|split("@")[0] %}
                            {% set emailDomain = employed.email|split("@")[1] %}
                            <i class="fa-duotone fa-circle-phone"></i> {{ employed.gsm }}
                            | <i class="fa-duotone fa-envelope"></i> {{ emailUser }}<span class="arobase"><span>(arobase)</span></span>{{ emailDomain }}
                            {% if employed.rsacNumber is not null %}
                                | RSAC : {{ employed.rsacNumber }}
                            {% endif %}
                        </p>
                    </div>
                    <div class="col-4 justify-content-end d-flex">
                        {% if employed.employeds|length > 0 %}
                            <!-- Button trigger modal -->
                            <button type="button" class="btn bnt-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#openModalFilleuls">
                                Découvrez mon équipe
                            </button>

                            <!-- Modal -->
                            <div class="modal fade" id="openModalFilleuls" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
                                    <div class="modal-content border-dark">
                                        <div class="modal-body">
                                            <div class="row align-items-center">
                                                <div class="col-11"><h4 class="title-h3 mb-0">Découvrez mon équipe</h4></div>
                                                <div class="col-1"><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                            </div>
                                            <div class="row justify-content-center g-2 mb-2">
                                                {% for e in employed.employeds %}
                                                    {% if 'ROLE_PRESCRIBER' not in e.roles and e.isVerified is same as(true) %}
                                                        <div class="col-3 rounded-1 mt-3">
                                                            <div class="bg-light border-dark border rounded-1 p-2">
                                                                <div class="row justify-content-center">
                                                                    <div class="col-6">
                                                                        <p class="text-center">
                                                                            {% if employed.avatarName is not null %}
                                                                                <img class="img-fluid rounded-circle" src="{{ asset('images/avatar/' ~ e.avatarName)|imagine_filter('noscollaborateursvierge_card') }}" alt="{{ e.firstName }} {{ e.lastName }}">
                                                                            {% else %}
                                                                                <img class="img-fluid rounded-circle" src="{{ asset('images/jpeg/LogoPAPSimmo-Blanc.jpg')|imagine_filter('noscollaborateursvierge_card')}}" alt="pas d'avatar">
                                                                            {% endif %}
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                                <div class="row" id="content_article">
                                                                    <div class="col-12">
                                                                        <p class="mb-0 text-center"> {% if employed.civility == 1%}M.{% else %}Mme{% endif%} {{ e.firstName }} {{ e.lastName }}</p>
                                                                    </div>
                                                                </div>
                                                                <a class="btn btn-sm btn-outline-success w-100" href="{{ path('op_admin_employed_showwithproperty', {'id': e.id}) }}">Voir sa page</a>
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="listpropertiescoll" class="container">
        <div class="row mb-4">
            {% for property in properties %}
                <div class="col-xs-12 col-sm-6 col-md-6 col-xl-4 col-xxl-4 p-4 g-3">
                    {{ include('webapp/page/property/include/_cardProperty.html.twig') }}
                </div>
            {% endfor %}
        </div>
    </section>

{% endblock %}
