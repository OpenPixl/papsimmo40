{{ form_start(form) }}
<div class="row mt-2 d-flex align-items-center g-1">
    <div class="col-1 offset-6">
        <p><b>Filtres :</b></p>
    </div>
    <div class="col-1">
        {{ form_widget(form.refmandat, {'attr': {'class':'form-control form-control-sm w-100', 'placeholder':'N° Mandat'}}) }}
    </div>
    <div class="col-1">
        {{ form_widget(form.minPrice, {'attr': {'class':'form-control form-control-sm w-100', 'placeholder':'prix min'}}) }}
    </div>
    <div class="col-1">
        {{ form_widget(form.maxPrice, {'attr': {'class':'form-control form-control-sm w-100', 'placeholder':'prix max'}}) }}
    </div>
    <div class="col-1">
        {{ form_widget(form.zipcode, {'attr': {'class':'form-control form-control-sm w-100', 'placeholder':'Code postal'}}) }}
    </div>
    <div class="col-1 d-flex justify-content-end">
        <button type="submit" class="btn btn-sm btn-primary submitFormSearch">Filtrer</button>
    </div>
</div>

{{ form_end(form) }}
