<div class="row">
    <div class="col-12">
        <h3>Search Property</h3>
        {{ form_start(form) }}
        {{ form_row(form) }}
        <button type="submit">Envoyer</button>
        {{ form_end(form) }}
    </div>

    <div class="row">
        <div class="col-12">
            {% if pagination is not empty %}
                <h3>Nombre de résultats : {{ pagination.totalItemCount }}</h3>
                <hr>
                <ul class="list-group my-4">

                    {% for item in pagination %}
                        <li class="list-group-item list-group-item-action">{{ item.name }} | {{ item.refEmployed }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</div>