<div class="header">
    <div class="row" style="display:flex;align-items: center;">
        <div class="col-2">
            <img class="img-fluid p-3" src="{{ absolute_url(asset('images/png/LogoPAPSimmo.png'))}}" alt="{{ application.nameSite }}">
        </div>
        <div class="col-6">
            <h1 class="title-h1 text-start" style="text-align: center">{{ property.city }} | {{ property.propertyRubric|upper }}</h1>
        </div>
        <div class="col-2">
            <h1 class="title-price text-end" style="text-align: center">{{ property.priceFai }}€</h1>
        </div>
        <div class="col-2">
            <p class="text-end">
                {% if property.qrcodeUrl is not null %}
                    {% set refyear = property.refnumdate|split('-',2) | first %}           {# on récupère AAAA #}
                    {% set numdate = property.refnumdate|split('-',2) | last %}            {# on récupère MMDDSS #}
                    {% set numdiff = property.ref|split('-') | last %}            {# on récupère numéro de différenciation entre bien du même jour#}

                    {% set directory =  refyear ~ '-' ~ numdate ~ '-' ~ numdiff %}

                    <img src="{{ absolute_url(asset('properties/'~ directory ~'/' ~ property.qrcodeUrl)) }}" class="img-fluid w-50" alt="{{ property.qrcodeUrl }}">
                {% endif %}
            </p>
        </div>
    </div>
</div>